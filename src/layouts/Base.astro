---
// Hallmark · genre: editorial · design-system: design.md · designed-as-app
// theme: Newsprint · nav: N6 · footer: Ft4
//
// Todo el CSS del sitio vive en src/styles/global.css, importado aquí una
// sola vez. Ver la cabecera de ese fichero para el porqué.
import "../styles/global.css";
import { urlInicio, urlSeccion, urlRadar, urlTendencias } from "../lib/ui";

// `edicion` es la línea de arriba de la cabecera. Antes la escribía cada
// isla por JS al terminar su fetch; ahora llega horneada desde el build.
interface Props {
  title?: string;
  seccion?: string;
  edicion?: string;
}
const {
  title = "El Contraste",
  seccion = "",
  edicion = "Agregador de prensa contrastada",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Display&family=Spectral:wght@400;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- `marco` en los tres: la cabecera se alinea con el contenido en vez de
         sobresalir por los lados, que era el desajuste más visible en ancho. -->
    <header class="mast marco">
      <p class="mast-line">{edicion}</p>
      <a class="mast-name" href={urlInicio()}>El Contraste</a>
      <nav class="mast-nav" aria-label="Principal">
        <ul>
          <li><a href={urlInicio()} class={seccion === "hoy" ? "activo" : ""}>Portada</a></li>
          <li>
            <a href={urlSeccion("economico")} class={seccion === "seccion" ? "activo" : ""}>
              Secciones
            </a>
          </li>
          <li>
            <a href={urlRadar("economico")} class={seccion === "radar" ? "activo" : ""}>Radar</a>
          </li>
          <li>
            <a href={urlTendencias()} class={seccion === "tendencias" ? "activo" : ""}>
              Tendencias
            </a>
          </li>
        </ul>
      </nav>
      <hr class="rule-double" aria-hidden="true" />
    </header>

    <main class="contenido marco">
      <slot />
    </main>

    <footer class="colofon">
      <div class="marco">
        <p>
          El Contraste · agregador personal, sin ánimo de lucro · Las síntesis las
          redacta un modelo de lenguaje (Haiku 4.5) a partir de los textos de los
          medios enlazados; pueden contener errores. Lee siempre el original.
          Agrupación por similitud coseno ≥ 0,75 sobre embeddings MiniLM
          multilingüe, ventana de 48 h, mínimo 2 medios por historia. No se
          republica el texto de los artículos ni se sortean muros de pago.
          Compuesto con Libre Caslon Display, Spectral e IBM Plex Mono.
        </p>
      </div>
    </footer>
  </body>
</html>
