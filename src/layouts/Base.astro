---
// Hallmark · genre: editorial · design-system: design.md · designed-as-app
// theme: Newsprint · nav: N6 · footer: Ft4
//
// Todo el CSS del sitio vive en src/styles/global.css, importado aquí una
// sola vez. Ver la cabecera de ese fichero para el porqué.
import "../styles/global.css";
import Tema from "../components/Tema.astro";
import {
  urlInicio,
  urlResumen,
  urlSeccion,
  urlRadar,
  urlFocos,
  urlTendencias,
  urlContacto,
  urlEstatico,
} from "../lib/ui";

// `edicion` es la línea de arriba de la cabecera. Antes la escribía cada
// isla por JS al terminar su fetch; ahora llega horneada desde el build.
interface Props {
  title?: string;
  seccion?: string;
  edicion?: string;
  /** Resumen de la página: <meta description> y tarjeta al compartir. */
  descripcion?: string;
}
const {
  title = "La Doxa",
  seccion = "",
  edicion = "Agregador de prensa contrastada",
  // Alineada con el lema de la portada (`.posicionamiento`), que es lo que
  // define al sitio. Lo descriptivo va primero: un buscador corta por el final.
  descripcion = "Todas las versiones de una misma noticia, juntas: en qué " +
    "coinciden los medios, en qué se contradicen y qué cuenta uno solo. " +
    "Doxa es la opinión, no el saber.",
} = Astro.props;

// URL absoluta de ESTA página. Sale de `site` (SITE_URL en el workflow), así
// que con el dominio propio conectado el canonical y las tarjetas apuntan a
// noticiasdoxa.es sin tocar nada más. Astro.site puede faltar en un `astro
// dev` mal configurado: sin canonical se vive, con uno roto no.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Tarjeta social de 1200×630 (public/og.png). Con ella la tarjeta pasa de
// `summary` (icono pequeño al lado del texto) a `summary_large_image`.
// Cómo se regenera: docs/despliegue.md § La tarjeta social.
const imagenSocial = Astro.site
  ? new URL(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/og.png`, Astro.site).href
  : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={descripcion} />
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- El icono se sirve desde public/. Con `urlEstatico` porque Astro no
         reescribe los href escritos a mano y en GitHub Pages el sitio cuelga
         de /<repo>/ (mismo motivo que el resto de helpers de ui.ts). -->
    <link rel="icon" href={urlEstatico("favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={urlEstatico("apple-touch-icon.png")} />

    <!-- El color de la barra del navegador sigue al papel del tema: sin esto,
         en móvil el sistema pinta una franja blanca sobre la portada nocturna.
         Son los hex exactos de --color-paper (design.md § Theme).
         Una sola etiqueta, sin `media`: desde que hay botón, el tema puede no
         coincidir con el del sistema y el script de abajo la mantiene al día. -->
    <meta name="theme-color" content="#f8f5ee" />

    <!-- Tema elegido. `is:inline` y aquí arriba a propósito: tiene que correr
         ANTES del primer pintado o se ve un fogonazo claro antes de aplicarse
         el modo oscuro. Por eso no puede ser el script normal de Astro, que va
         diferido. Es la única lógica del sitio que no puede esperar. -->
    <script is:inline>
      (function () {
        // Marca de que hay JS. El revelado al hacer scroll solo esconde
        // contenido si esta marca está puesta: sin script, la página se ve
        // entera. Va aquí y no al final para que el CSS ya la encuentre.
        document.documentElement.dataset.js = "";
        try {
          var elegido = localStorage.getItem("tema");
          if (elegido === "dark" || elegido === "light") {
            document.documentElement.dataset.theme = elegido;
          }
          var oscuro = elegido
            ? elegido === "dark"
            : matchMedia("(prefers-color-scheme: dark)").matches;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.content = oscuro ? "#130e09" : "#f8f5ee";
        } catch (e) {
          /* localStorage puede fallar (modo privado, cookies bloqueadas).
             Sin preferencia guardada el sitio sigue el sistema y todo va. */
        }
      })();
    </script>

    <!-- Tarjeta al compartir. Sin esto un enlace pegado en WhatsApp o Mastodon
         sale como una URL desnuda. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="La Doxa" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={descripcion} />
    {canonical && <meta property="og:url" content={canonical} />}
    {
      imagenSocial && (
        <>
          <meta property="og:image" content={imagenSocial} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content="La Doxa · agregador de prensa contrastada" />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Display&family=Spectral:wght@400;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- `marco` en los tres: la cabecera se alinea con el contenido en vez de
         sobresalir por los lados, que era el desajuste más visible en ancho. -->
    <header class="mast marco">
      <p class="mast-line">{edicion}</p>
      <a class="mast-name" href={urlInicio()}>La Doxa</a>
      <nav class="mast-nav" aria-label="Principal">
        <ul>
          <li><a href={urlInicio()} class={seccion === "hoy" ? "activo" : ""}>Portada</a></li>
          <li>
            <a href={urlResumen()} class={seccion === "resumen" ? "activo" : ""}>Escuchar</a>
          </li>
          <li>
            <a href={urlSeccion("economico")} class={seccion === "seccion" ? "activo" : ""}>
              Secciones
            </a>
          </li>
          <li>
            <a href={urlFocos()} class={seccion === "focos" ? "activo" : ""}>Focos</a>
          </li>
          <li>
            <a href={urlRadar("economico")} class={seccion === "radar" ? "activo" : ""}>Radar</a>
          </li>
          <li>
            <a href={urlTendencias()} class={seccion === "tendencias" ? "activo" : ""}>
              Tendencias
            </a>
          </li>
          <li>
            <a href={urlContacto()} class={seccion === "contacto" ? "activo" : ""}>Contacto</a>
          </li>
          <li><Tema /></li>
        </ul>
      </nav>
      <hr class="rule-double" aria-hidden="true" />
    </header>

    <main class="contenido marco">
      <slot />
    </main>

    <!-- Colofón denso (design.md § Nav y footer), pero repartido en columnas
         de periódico: hasta el 2026-08-16 era UN párrafo de 72ch centrado, y
         en escritorio quedaban 518 px de letra pequeña en medio de 1584 —una
         maqueta de móvil estirada—. La densidad y los parámetros reales del
         sistema no cambian: lo que cambia es que cada dato lleva su rótulo y
         ocupa el ancho de la página. -->
    <footer class="colofon">
      <div class="marco colofon-rejilla">
        <section>
          <p class="colofon-rotulo">La Doxa</p>
          <p>
            Agregador personal de noticias contrastadas. Sin ánimo de lucro y sin
            publicidad. Compuesto con Libre Caslon Display, Spectral e IBM Plex Mono.
          </p>
        </section>
        <section>
          <p class="colofon-rotulo">Las síntesis</p>
          <p>
            Las redacta un modelo de lenguaje (Haiku 4.5) a partir de los textos de
            los medios enlazados; pueden contener errores. Lee siempre el original.
          </p>
        </section>
        <section>
          <p class="colofon-rotulo">La agrupación</p>
          <p>
            Similitud coseno ≥ 0,75 sobre embeddings MiniLM multilingüe, ventana de
            48 h y mínimo 2 medios por historia.
          </p>
        </section>
        <section>
          <p class="colofon-rotulo">Los medios</p>
          <p>
            No se republica el texto de los artículos ni se sortean muros de pago.
          </p>
          <p class="colofon-contacto">
            <a href="mailto:contacto@noticiasdoxa.es">contacto@noticiasdoxa.es</a>
          </p>
        </section>
      </div>
    </footer>

    <!-- Este SÍ puede ir diferido: nadie pulsa el botón antes de que cargue.
         El estado "actual" se resuelve preguntando, no guardando una variable:
         sin elección previa el tema lo manda el sistema, y leer el DOM es la
         única forma de que el primer clic vaya en la dirección correcta. -->
    <script>
      const raiz = document.documentElement;
      const meta = document.querySelector('meta[name="theme-color"]');
      const boton = document.querySelector(".tema");

      const esOscuro = () =>
        raiz.dataset.theme
          ? raiz.dataset.theme === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;

      let quitarFundido;
      boton?.addEventListener("click", () => {
        const nuevo = esOscuro() ? "light" : "dark";

        // El fundido se enciende solo durante el cambio y se apaga después:
        // dejarlo puesto arrastraría una transición de fondo en cada hover.
        raiz.classList.add("cambiando-tema");
        clearTimeout(quitarFundido);
        quitarFundido = setTimeout(() => raiz.classList.remove("cambiando-tema"), 400);

        raiz.dataset.theme = nuevo;
        if (meta) meta.content = nuevo === "dark" ? "#130e09" : "#f8f5ee";
        try {
          localStorage.setItem("tema", nuevo);
        } catch (e) {
          /* Sin persistencia el tema dura lo que la pestaña. Mejor que nada. */
        }
      });

      // ---- Revelado al entrar en pantalla -------------------------------
      // IntersectionObserver y no scroll: el navegador avisa, nadie sondea.
      // Se deja de observar en cuanto algo aparece — es una entrada, no un
      // efecto que deba repetirse cada vez que subes y bajas.
      if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
        // ⚠️ `.rotulo-doc` NO está aquí, y no es un olvido (2026-08-17).
        // Todas estas piezas se valen solas: si una llega tarde, llega tarde
        // entera. Un rótulo no — ETIQUETA a un contenido que no se revela con
        // él, así que mientras se funde (520 ms, más el escalonado) el lector
        // ve los bloques sin su título. En /cluster/497/ eso eran cinco
        // contradicciones flotando sin el rótulo «Dónde no cuadran las
        // versiones», y era imposible saber qué se estaba leyendo. Si el
        // revelado además falla, se queda así para siempre.
        // Un titular de 23 px no gana nada con un fundido y lo pierde todo si
        // no llega: se pinta y ya.
        // `.asunto-fila` y `.crono-dia` entran por lo mismo que `.lista-foco`:
        // son filas completas —titular más cifras, o un día con sus historias—
        // que se leen solas. `.toca-punto` NO está: es la apertura de la portada
        // y vive sobre el pliegue, así que el propio filtro de más abajo lo
        // dejaría fuera; tenerlo aquí solo invitaría a que un día alguien lo
        // moviera y se llevara la primera pantalla por delante.
        const piezas = document.querySelectorAll(
          ".ficha, .banda, .cifra-hero, .tabla-envoltorio, .lista-huecos, " +
            ".relato, .filas-datos, .multiple, .lista-foco, .asunto-fila, .crono-dia",
        );
        const vigia = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("visible");
              vigia.unobserve(e.target);
            }
          },
          // El margen de abajo es POSITIVO: la pieza empieza a entrar cuando
          // aún le falta un 12 % de pantalla para asomar, así llega ya
          // compuesta. Era -8 % ("que no se revele cuando solo asoma un
          // píxel") y el efecto era el contrario del buscado: bajando rápido,
          // la entrada de 520 ms arrancaba con la pieza ya en pantalla y
          // durante medio segundo se veía un hueco en blanco donde debía
          // haber texto. Justo encima del colofón eso se lee como una página
          // cortada.
          { rootMargin: "0px 0px 12% 0px", threshold: 0.01 },
        );

        // Lo que YA se ve al cargar no se esconde. Es deliberado: ocultar el
        // titular principal hasta que corra un script retrasa el LCP y deja
        // la portada en blanco si el JS tarda o falla. La entrada de la
        // primera pantalla la hace el CSS (la cabecera), que no depende de
        // nada. El revelado es solo para lo que llega al hacer scroll.
        let bajoElPliegue = 0;
        piezas.forEach((pieza) => {
          if (pieza.getBoundingClientRect().top < innerHeight) return;
          pieza.classList.add("revelable");
          // Escalonado SOLO para la primera cascada, la que se ve nada más
          // empezar a bajar. Antes era `Math.min(bajoElPliegue++, 4) * 60`, y
          // ese tope no acotaba la cascada: le clavaba 240 ms fijos de espera
          // a TODA pieza a partir de la quinta. Sumados a los 520 ms de la
          // entrada, cada sección nueva pasaba tres cuartos de segundo en
          // blanco después de estar ya en pantalla.
          if (bajoElPliegue < 5) {
            pieza.style.setProperty("--retraso", bajoElPliegue * 60 + "ms");
          }
          bajoElPliegue++;
          vigia.observe(pieza);
        });

        // ---- Red de seguridad ------------------------------------------
        // ⚠️ Un IntersectionObserver solo avisa de CRUCES de umbral. Si un
        // salto de scroll —tecla Fin, arrastrar la barra, un flick de
        // trackpad— pasa una pieza de "debajo del pliegue" a "encima" sin
        // que llegue a intersecar en ningún fotograma, no hay entrada, no
        // hay clase `visible`, y esa pieza se queda en `opacity: 0` PARA
        // SIEMPRE. Medido el 2026-08-16 en la portada: saltando al final
        // quedaban 11 piezas invisibles y la última superficie era un hueco
        // en blanco justo encima del colofón, que es lo que se reportó como
        // "el pie está recortado".
        //
        // Tras cada scroll se barren las que ya han quedado por encima del
        // pliegue. No se comprueba nada más: lo que sigue en pantalla o por
        // debajo lo ve el vigía, y aquí solo se rescata lo que se saltó.
        let pendiente = false;
        const quedanOcultas = () => document.querySelectorAll(".revelable:not(.visible)");
        const barrer = () => {
          pendiente = false;
          for (const pieza of quedanOcultas()) {
            if (pieza.getBoundingClientRect().bottom >= 0) continue;
            pieza.classList.add("visible");
            vigia.unobserve(pieza);
          }
          // Cuando no queda nada escondido, el oyente sobra.
          if (quedanOcultas().length === 0) removeEventListener("scroll", alHacerScroll);
        };
        const alHacerScroll = () => {
          if (pendiente) return;
          pendiente = true;
          requestAnimationFrame(barrer);
        };
        addEventListener("scroll", alHacerScroll, { passive: true });

        // ---- Segunda red: volver a una pestaña de fondo --------------------
        // ⚠️ En una pestaña oculta Chrome PARA `requestAnimationFrame` y no
        // entrega notificaciones del IntersectionObserver. Y abrir un enlace
        // en segundo plano (cmd+clic, "abrir en pestaña nueva") es la mitad de
        // las visitas: el script marca las piezas como `revelable`, la página
        // se queda congelada a `opacity: 0` y el vigía puede no ponerse al día
        // hasta que haya un scroll — que quizá no llega, porque lo primero que
        // hace el lector es mirar lo que ya tiene delante.
        // Al volver a la pestaña se revela TODO lo que ya está en pantalla o
        // por encima. No es lo mismo que `barrer`, que solo rescata lo que
        // quedó por arriba: aquí lo que importa es justo lo que se está
        // mirando.
        addEventListener("visibilitychange", () => {
          if (document.visibilityState !== "visible") return;
          for (const pieza of quedanOcultas()) {
            if (pieza.getBoundingClientRect().top >= innerHeight) continue;
            pieza.classList.add("visible");
            vigia.unobserve(pieza);
          }
        });
      }

      // ---- Glosario: cerrar el globo con Escape ---------------------------
      // El globo se abre y se cierra con CSS (`:hover` y `:focus-within` sobre
      // .termino-caja), así que con ratón y con el dedo no hace falta JS. Con
      // teclado sí: el foco se queda en el botón hasta que tabulas fuera, y la
      // convención de cualquier cosa que se despliega es que Escape la cierre.
      addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        const activo = document.activeElement;
        if (activo instanceof HTMLElement && activo.classList.contains("termino")) activo.blur();
      });

      // ---- Voz del resumen diario -----------------------------------------
      // Lee EXACTAMENTE lo que está escrito en la página: el saludo, y luego
      // cada punto tal y como se ve. Nada de un guion aparte — un texto hablado
      // distinto del publicado sería una segunda versión que nadie revisa.
      const voz = document.querySelector("[data-voz]");
      if (voz && "speechSynthesis" in window) {
        const sintesis = window.speechSynthesis;
        const play = voz.querySelector("[data-voz-play]");
        const parar = voz.querySelector("[data-voz-stop]");
        const etiqueta = voz.querySelector("[data-voz-texto]");

        // La lista de voces llega vacía en el primer tick en casi todos los
        // navegadores y se rellena después, de forma asíncrona. Se resuelve en
        // el momento de hablar, no al cargar.
        const vozEspanola = () => {
          const todas = sintesis.getVoices();
          return (
            todas.find((v) => v.lang === "es-ES") ||
            todas.find((v) => v.lang.startsWith("es")) ||
            null
          );
        };

        const saludo = () => {
          const h = new Date().getHours();
          const momento = h < 6 ? "Buenas noches" : h < 14 ? "Buenos días" : h < 21 ? "Buenas tardes" : "Buenas noches";
          return `${momento}. Bienvenido a La Doxa. Esto es lo que hay que saber hoy.`;
        };

        // El texto, leído del DOM ya horneado. Se recogen las frases enteras y
        // se trocean por puntuación más abajo.
        const guion = () => {
          const partes = [saludo()];
          const entradilla = document.querySelector(".resumen-entradilla");
          if (entradilla?.textContent) partes.push(entradilla.textContent);
          document.querySelectorAll(".resumen-punto").forEach((punto, i) => {
            const titulo = punto.querySelector(".resumen-titulo")?.textContent ?? "";
            const porque = punto.querySelector(".resumen-porque")?.textContent ?? "";
            partes.push(`${i + 1}. ${titulo}. ${porque}`);
          });
          partes.push("Hasta aquí el resumen. Cada historia enlaza con las versiones originales.");
          return partes;
        };

        // ⚠️ Se encola UNA frase por utterance, no el texto entero. Chrome
        // corta cualquier locución que pase de ~15 segundos, y un resumen de
        // seis puntos los pasa de largo: en una sola utterance se callaría a
        // mitad del segundo punto, sin error ni evento. Troceado por frases
        // ninguna llega al límite, y de paso la pausa entre ellas suena mejor.
        const trocear = (partes) =>
          partes
            .flatMap((p) => p.split(/(?<=[.?!])\s+/))
            .map((f) => f.trim())
            .filter(Boolean);

        let hablando = false;
        const pintar = (estado) => {
          if (etiqueta) etiqueta.textContent = estado;
          if (parar) parar.hidden = !hablando;
          voz.classList.toggle("voz-activa", hablando);
        };

        const detener = () => {
          sintesis.cancel();
          hablando = false;
          pintar("Escuchar el resumen");
        };

        // ⚠️ El estado lo lleva `hablando`, NO `speechSynthesis.paused`.
        // Chrome deja `paused` en `true` sin haber hablado nunca (queda así
        // tras un `cancel()`), y preguntándole a él el PRIMER clic entraba en
        // la rama de "reanudar": el botón cambiaba a «Pausar», no sonaba nada
        // y no había forma de volver atrás. Nuestra bandera solo la mueven el
        // clic y el final de la última frase, así que no puede mentir.
        play?.addEventListener("click", () => {
          if (hablando && !sintesis.paused) {
            sintesis.pause();
            pintar("Seguir escuchando");
            return;
          }
          if (hablando && sintesis.paused) {
            sintesis.resume();
            pintar("Pausar");
            return;
          }
          // Empezar de cero: `cancel()` limpia cualquier cola anterior, que es
          // lo que deja el estado raro de arriba.
          sintesis.cancel();
          const elegida = vozEspanola();
          const frases = trocear(guion());
          hablando = true;
          frases.forEach((frase, i) => {
            const u = new SpeechSynthesisUtterance(frase);
            u.lang = "es-ES";
            if (elegida) u.voice = elegida;
            u.rate = 1.0;
            if (i === frases.length - 1) u.addEventListener("end", detener);
            u.addEventListener("error", detener);
            sintesis.speak(u);
          });
          pintar("Pausar");
        });

        parar?.addEventListener("click", detener);
        // Salir de la página con la voz en marcha la dejaba sonando en Chrome:
        // `speechSynthesis` vive en el navegador, no en el documento.
        addEventListener("pagehide", () => sintesis.cancel());

        // Se enseña solo si hay voz que lo lea. Sin ninguna instalada, un botón
        // que no hace nada al pulsarlo es peor que no tener botón.
        const mostrar = () => {
          if (sintesis.getVoices().length > 0) voz.hidden = false;
        };
        mostrar();
        sintesis.addEventListener("voiceschanged", mostrar);
      }
    </script>
  </body>
</html>
