---
import Base from "../layouts/Base.astro";
// Familia índice (20 · Ecosystem Index): navegar una categoría a lo largo del
// tiempo, que es donde la taxonomía cerrada empieza a pagar.
---

<Base title="El Contraste — sección" seccion="seccion">
  <nav class="conmutador" id="conmutador" aria-label="Secciones"></nav>
  <div id="cuerpo"><p class="estado">Cargando la sección…</p></div>
</Base>

<script>
  import { esc, traer, rotula, ficha, SECCIONES } from "../lib/ui";

  const params = new URLSearchParams(location.search);
  const seccion = params.get("s") ?? "economico";
  const tema = params.get("tema");
  const dias = Number(params.get("dias") ?? 7);

  const url = (s: string, t?: string | null) =>
    `/seccion?s=${encodeURIComponent(s)}${t ? `&tema=${encodeURIComponent(t)}` : ""}&dias=${dias}`;

  async function main() {
    const cuerpo = document.getElementById("cuerpo")!;

    // Conmutador de secciones: solo las que existen en la taxonomía.
    try {
      const taxonomia: any[] = await traer("/api/topics");
      document.getElementById("conmutador")!.innerHTML = taxonomia
        .map(
          (t) =>
            `<a class="chip${t.section === seccion ? " chip-activo" : ""}" href="${url(t.section)}">${esc(
              rotula(t.section),
            )}</a>`,
        )
        .join("");

      // Filtro por tema dentro de la sección activa.
      const actual = taxonomia.find((t) => t.section === seccion);
      if (actual) {
        document.getElementById("conmutador")!.insertAdjacentHTML(
          "afterend",
          `<nav class="conmutador conmutador-temas" aria-label="Temas">
             <a class="chip${!tema ? " chip-activo" : ""}" href="${url(seccion)}">todos</a>
             ${actual.topics
               .map(
                 (t: string) =>
                   `<a class="chip${t === tema ? " chip-activo" : ""}" href="${url(seccion, t)}">${esc(t)}</a>`,
               )
               .join("")}
           </nav>`,
        );
      }
    } catch {
      /* El conmutador es navegación auxiliar: si falla, la lista sigue sirviendo. */
    }

    try {
      const q = `/api/section/${encodeURIComponent(seccion)}?days=${dias}${
        tema ? `&topic=${encodeURIComponent(tema)}` : ""
      }`;
      const datos: any = await traer(q);

      document.title = `${rotula(seccion)} — El Contraste`;
      document.getElementById("mast-edicion")!.textContent =
        `${rotula(seccion)}${tema ? ` · ${tema}` : ""} · últimos ${dias} días`;

      if (!datos.n_clusters) {
        cuerpo.innerHTML = `
          <div class="banda"><span class="banda-num">01</span><h2>${esc(rotula(seccion))}</h2></div>
          <p class="aviso">Ninguna historia en esta sección en los últimos ${dias} días.
          Si acabas de añadir feeds, la sección se llena a partir del próximo digest.</p>`;
        return;
      }

      // Agrupado por día: el orden natural de un archivo de prensa.
      const porDia = new Map<string, any[]>();
      for (const c of datos.clusters) {
        if (!porDia.has(c.digest_date)) porDia.set(c.digest_date, []);
        porDia.get(c.digest_date)!.push(c);
      }

      cuerpo.innerHTML = `
        <div class="banda">
          <span class="banda-num">01</span>
          <h2>${esc(rotula(seccion))}${tema ? ` · ${esc(tema)}` : ""}</h2>
          <span class="cuenta">${datos.n_clusters} historias / ${dias} días</span>
        </div>
        ${[...porDia.entries()]
          .map(
            ([dia, cs]) => `
          <section class="jornada">
            <h3 class="jornada-fecha dato">${esc(dia)}</h3>
            <div class="jornada-lista">${cs.map((c: any) => ficha(c)).join("")}</div>
          </section>`,
          )
          .join("")}`;
    } catch (err) {
      cuerpo.innerHTML = `<p class="estado">No se pudo cargar la sección: ${esc(err)}</p>`;
    }
  }
  main();
</script>

<style is:global>
  .jornada {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: var(--space-lg);
    border-top: var(--rule-hair) solid var(--color-rule);
    padding: var(--space-sm) 0;
  }
  .jornada-fecha {
    font-size: var(--text-xs);
    color: var(--color-neutral);
    margin: 0;
    position: sticky;
    top: var(--space-sm);
    align-self: start;
  }
  .jornada-lista { display: grid; gap: var(--space-sm); }
  .jornada-lista .ficha + .ficha {
    border-top: var(--rule-hair) dotted var(--color-rule);
    padding-top: var(--space-sm);
  }

  @media (max-width: 40rem) {
    .jornada { grid-template-columns: minmax(0, 1fr); gap: var(--space-2xs); }
    .jornada-fecha { position: static; }
  }
</style>
