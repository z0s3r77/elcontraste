---
import Base from "../layouts/Base.astro";
// Macrostructure: 02 · Long Document — el relato se lee de corrido y el aparato
// de contraste cuelga de él. Una sola columna, medida 64ch, sin reveals.
---

<Base title="El Contraste — historia">
  <article id="historia"><p class="estado">Cargando la historia…</p></article>
</Base>

<script>
  import { esc, traer, rotula } from "../lib/ui";

  const parrafos = (texto: string) =>
    esc(texto)
      .split(/\n{2,}/)
      .map((p) => `<p>${p.replace(/\n/g, "<br>")}</p>`)
      .join("");

  function seccion(titulo: string, cuerpo: string) {
    return cuerpo
      ? `<h2 class="rotulo-doc">${esc(titulo)}</h2>${cuerpo}`
      : "";
  }

  async function main() {
    const raiz = document.getElementById("historia")!;
    const id = new URLSearchParams(location.search).get("id");
    if (!id) {
      raiz.innerHTML = `<p class="estado">Falta el parámetro <code>id</code>.</p>`;
      return;
    }

    try {
      const c: any = await traer(`/api/clusters/${encodeURIComponent(id)}`);
      const s = c.synthesis;

      document.title = `${c.headline ?? "Historia"} — El Contraste`;
      document.getElementById("mast-edicion")!.textContent =
        `${rotula(c.section ?? "")} · ${c.digest_date ?? ""}`;

      // Cabecera del documento: el titular y de quién sale.
      const cabecera = `
        <header class="doc-cabecera">
          <p class="doc-seccion">
            <a href="/seccion?s=${encodeURIComponent(c.section ?? "")}">${esc(rotula(c.section ?? "—"))}</a>
            ${(c.topics ?? []).map((t: string) => `<span class="tema">${esc(t)}</span>`).join("")}
          </p>
          <h1>${esc(c.headline ?? "(sin titular todavía)")}</h1>
          <p class="doc-meta">
            Contrastada entre <span class="dato">${c.n_sources}</span> medios sobre
            <span class="dato">${c.n_articles}</span> versiones ·
            <span class="dato">${esc(c.digest_date ?? "")}</span>
          </p>
        </header>`;

      if (!s) {
        raiz.innerHTML = `${cabecera}
          <p class="aviso">Esta historia está agrupada pero todavía no tiene síntesis:
          el presupuesto diario cubre las historias con más medios detrás.</p>
          ${listaFuentes(c)}`;
        return;
      }

      const divergentes = (s.hechos_divergentes ?? []).length
        ? `<div class="divergencias">
             ${s.hechos_divergentes
               .map(
                 (d: any) => `
               <div class="divergencia">
                 <p class="divergencia-hecho">${esc(d.hecho)}</p>
                 <ul>${(d.solo_en ?? [])
                   .map((x: string) => `<li>${esc(x)}</li>`)
                   .join("")}</ul>
               </div>`,
               )
               .join("")}
           </div>`
        : "";

      const comunes = (s.hechos_comunes ?? []).length
        ? `<ul class="hechos">${s.hechos_comunes
            .map((h: string) => `<li>${esc(h)}</li>`)
            .join("")}</ul>`
        : "";

      raiz.innerHTML = `
        ${cabecera}
        ${s.relato ? `<div class="relato">${parrafos(s.relato)}</div>` : ""}
        <p class="firma-ia">
          Relato y contraste redactados por un modelo de lenguaje a partir de los
          textos enlazados abajo. Puede contener errores: los originales mandan.
        </p>
        ${seccion("En qué coinciden", comunes)}
        ${seccion("En qué se contradicen", divergentes)}
        ${seccion(
          "Cómo lo encuadra cada medio",
          s.diferencias_de_encuadre ? parrafos(s.diferencias_de_encuadre) : "",
        )}
        ${seccion(
          "Qué falta por saber",
          s.que_falta_por_saber ? parrafos(s.que_falta_por_saber) : "",
        )}
        ${listaFuentes(c)}`;
    } catch (err) {
      raiz.innerHTML = `<p class="estado">No se pudo cargar la historia: ${esc(err)}</p>`;
    }
  }

  function listaFuentes(c: any) {
    return `
      <h2 class="rotulo-doc">Las versiones originales</h2>
      <ul class="fuentes">
        ${(c.articles ?? [])
          .map(
            (a: any) => `
          <li>
            <span class="fuente-medio">${esc(a.medio)}</span>
            <a href="${esc(a.url)}" target="_blank" rel="noopener noreferrer">${esc(a.title)}</a>
          </li>`,
          )
          .join("")}
      </ul>`;
  }

  main();
</script>

<style is:global>
  #historia { max-width: var(--measure); margin: 0 auto; }

  .doc-cabecera { margin-bottom: var(--space-lg); }
  .doc-seccion {
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 var(--space-2xs);
  }
  .doc-seccion a { color: var(--color-accent); text-decoration: none; }
  .doc-seccion .tema { margin-left: var(--space-2xs); color: var(--color-neutral); }
  .doc-cabecera h1 {
    font-size: clamp(1.875rem, 5vw, 3rem);
    margin: 0 0 var(--space-xs);
  }
  .doc-meta {
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
    color: var(--color-neutral);
    border-bottom: var(--rule-hair) solid var(--color-ink);
    padding-bottom: var(--space-2xs);
    margin: 0;
  }

  /* El relato: prosa de lectura, con capitular. Es el cuerpo del documento. */
  .relato { margin: var(--space-lg) 0 var(--space-sm); }
  .relato p { margin: 0 0 var(--space-sm); line-height: 1.7; }
  .relato p:first-of-type::first-letter {
    float: left;
    font-family: var(--font-display);
    font-size: 3.4em;
    line-height: 0.82;
    padding: 0.05em 0.08em 0 0;
    color: var(--color-accent);
  }

  .firma-ia {
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--color-neutral);
    border-top: var(--rule-hair) solid var(--color-rule);
    border-bottom: var(--rule-hair) solid var(--color-rule);
    padding: var(--space-2xs) 0;
    margin: 0 0 var(--space-lg);
  }

  /* Rótulos que emergen del flujo, no bloques con fondo. */
  .rotulo-doc {
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-muted);
    border-top: var(--rule-hair) solid var(--color-ink);
    padding-top: var(--space-2xs);
    margin: var(--space-xl) 0 var(--space-sm);
  }

  ul.hechos { padding-left: 1.1rem; margin: 0; }
  ul.hechos li { margin-bottom: var(--space-2xs); line-height: 1.6; }

  .divergencia {
    border-left: 3px solid var(--color-alerta);
    padding: var(--space-3xs) var(--space-sm);
    margin-bottom: var(--space-sm);
  }
  .divergencia-hecho { margin: 0 0 var(--space-3xs); font-weight: 600; }
  .divergencia ul { margin: 0; padding-left: 1.1rem; }
  .divergencia li {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-bottom: var(--space-3xs);
  }

  .fuentes { list-style: none; margin: 0; padding: 0; }
  .fuentes li {
    padding: var(--space-2xs) 0;
    border-bottom: var(--rule-hair) dotted var(--color-rule);
  }
  .fuente-medio {
    display: block;
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-neutral);
  }
  .fuentes a { color: var(--color-ink); text-decoration: none; overflow-wrap: anywhere; }
  .fuentes a:hover { color: var(--color-accent); text-decoration: underline; }
</style>
