---
import Base from "../layouts/Base.astro";
import { traer, type Tendencia } from "../lib/api";
import { rotula, urlSeccion } from "../lib/ui";

// Familia datos (04 · Stat-Led). La cobertura diferencial se ha movido a la
// portada (superficie 03 del Ecosystem Index): aquí sobraba duplicada y allí
// es lo que engancha. Esta página se queda con la serie temporal, que es lo
// único que necesita histórico.
//
// La tabla se hornea; la gráfica NO puede: uPlot dibuja en canvas y necesita
// el navegador. Los datos viajan en un <script type="application/json"> y el
// cliente solo pinta — no vuelve a llamar a la API.

const [trends, accel] = await Promise.all([
  traer<Tendencia[]>("/api/trends?days=180"),
  traer<{ section: string; topic: string; avg_7d: number; avg_90d: number }[]>(
    "/api/trends/accelerating",
  ),
]);

const dias = new Set(trends.flatMap((t) => t.points.map((p) => p.day))).size;

// Los 8 temas con más días de datos.
const top = trends.slice(0, 8);
const ejeDias = [...new Set(top.flatMap((t) => t.points.map((p) => p.day)))].sort();
const series = top.map((t) => {
  const by = Object.fromEntries(t.points.map((p) => [p.day, p.n_clusters]));
  return ejeDias.map((d) => by[d] ?? 0);
});
const datosGrafica = { etiquetas: top.map((t) => t.topic), dias: ejeDias, series };
---

<Base
  title="El Contraste — tendencias"
  seccion="tendencias"
  edicion={`Tendencias · ${dias} ${dias === 1 ? "día" : "días"} de histórico`}
>
  <section class="cifra-hero">
    <p class="cifra dato">{dias}</p>
    <p class="cifra-frase">
      {dias === 1 ? "día registrado" : "días registrados"} desde que el pipeline empezó a
      contar temas. La serie gana sentido a partir de dos o tres semanas.
    </p>
  </section>

  {
    accel.length > 0 && (
      <>
        <div class="banda">
          <span class="banda-num">00</span>
          <h2>Subiendo</h2>
          <span class="cuenta">7 días &gt; 2× la media de 90</span>
        </div>
        <ul class="lista-acelera">
          {accel.map((a) => (
            <li>
              <a href={urlSeccion(a.section, a.topic)}>{a.topic}</a>
              <span class="dato muted">
                {a.avg_7d} vs {a.avg_90d}
              </span>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <div class="banda">
    <span class="banda-num">01</span>
    <h2>Historias por tema y día</h2>
    <span class="cuenta">8 temas con más histórico</span>
  </div>

  {
    trends.length === 0 ? (
      <p class="aviso">
        Todavía no hay días suficientes. El cron los va acumulando en cada pasada.
      </p>
    ) : (
      <>
        <div id="grafica" class="grafica" />
        <script type="application/json" id="datos-grafica" set:html={JSON.stringify(datosGrafica)} />

        <div class="banda">
          <span class="banda-num">02</span>
          <h2>Todos los temas</h2>
          <span class="cuenta">{trends.length} con datos</span>
        </div>
        <div class="tabla-envoltorio">
          <table class="tabla-radar">
            <thead>
              <tr>
                <th scope="col">Tema</th>
                <th scope="col">Sección</th>
                <th scope="col">Días</th>
                <th scope="col">Historias</th>
              </tr>
            </thead>
            <tbody>
              {trends.map((t) => (
                <tr>
                  <th scope="row">
                    <a href={urlSeccion(t.section, t.topic)}>{t.topic}</a>
                  </th>
                  <td>{rotula(t.section)}</td>
                  <td class="dato">{t.points.length}</td>
                  <td class="dato">{t.points.reduce((acc, p) => acc + p.n_clusters, 0)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )
  }
</Base>

<script>
  import uPlot from "uplot";
  import "uplot/dist/uPlot.min.css";

  const crudo = document.getElementById("datos-grafica")?.textContent;
  const contenedor = document.getElementById("grafica");

  if (crudo && contenedor) {
    const { etiquetas, dias, series } = JSON.parse(crudo) as {
      etiquetas: string[];
      dias: string[];
      series: number[][];
    };

    // Los colores de serie salen de tokens, no de hex sueltos (design.md).
    const token = (n: string) =>
      getComputedStyle(document.documentElement).getPropertyValue(n).trim();
    const colores = [1, 2, 3, 4, 5, 6, 7, 8].map((i) => token(`--serie-${i}`));

    const x = dias.map((d) => new Date(d + "T00:00:00Z").getTime() / 1000);
    // Un mínimo por día para que la serie no se aplaste; por encima de eso,
    // manda el ancho real del contenedor.
    const ancho = () => Math.max(contenedor.clientWidth || 640, dias.length * 44);

    const grafica = new uPlot(
      {
        width: ancho(),
        height: 300,
        series: [
          {},
          ...etiquetas.map((label, i) => ({
            label,
            stroke: colores[i % colores.length],
            width: 2,
          })),
        ],
        axes: [
          { stroke: token("--color-neutral"), grid: { stroke: token("--color-rule") } },
          {
            label: "historias",
            stroke: token("--color-neutral"),
            grid: { stroke: token("--color-rule") },
          },
        ],
      },
      [x, ...series] as any,
      contenedor,
    );

    // uPlot NO es responsive por su cuenta: fija el tamaño al construirse y se
    // queda con él. Sin esto, la gráfica ignora cualquier cambio de ventana.
    new ResizeObserver(() => grafica.setSize({ width: ancho(), height: 300 })).observe(
      contenedor,
    );
  }
</script>

