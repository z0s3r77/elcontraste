---
import Base from "../layouts/Base.astro";
import { traer, type Asunto } from "../lib/api";
import { pesoSeccion, rotula, urlAsunto, urlSeccion } from "../lib/ui";

// TENDENCIAS — «¿qué asuntos siguen vivos, y cuáles se apagaron sin cerrarse?»
//
// Familia datos (04 · Stat-Led). Rehecha en la Fase 13 (2026-08-18) porque el
// usuario la señaló con razón: «es TENDENCIAS, no dice nada».
//
// Lo que había era una rejilla de múltiplos con la serie diaria de ARTÍCULOS por
// sección: «SOCIAL 1127 art.». Dos problemas, y el segundo es el grave:
//
//   1. Con 8 días de histórico no hay tendencia que dibujar, y la propia página
//      lo confesaba en su cifra de apertura. Media pantalla para decir que aún
//      no se puede decir nada.
//   2. **Contaba artículos rastreados, o sea el pipeline y no la prensa.** Es
//      exactamente el fallo por el que ya se retiró la gráfica grande de totales
//      el 2026-08-16 (§ Páginas de datos: «la cifra que manda tiene que ser una
//      del LECTOR»), y había sobrevivido dentro de los múltiplos.
//
// Con los asuntos (Fase 13) la página puede medir algo que sí es de la prensa y
// que sí se sostiene con 8 días: **cuánto dura la atención**. Un asunto es el
// mismo suceso a lo largo de los días, así que su duración es un hecho sobre
// cómo cubre la prensa, no sobre cuántos feeds se leyeron.
//
// Y trae la señal que no da nadie: los asuntos que **dejaron de contarse** con
// varios días de vida. Eso no es un recuento, es un hallazgo.

// 60 días para que la página no dependa de la ventana de horneado. `min_dias` se
// filtra aquí y no en la API porque las dos superficies quieren cortes distintos.
const asuntos = await traer<Asunto[]>("/api/asuntos?days=60&limit=400");

const abiertos = asuntos.filter((a) => a.estado === "sigue" || a.estado === "nuevo");

// --- 01 · Lo que más dura ---------------------------------------------------
// Solo los que llevan 2+ días: uno de un día no ha «durado» nada.
const duraderos = asuntos
  .filter((a) => a.n_dias >= 2)
  .sort((a, b) => b.n_dias - a.n_dias || b.n_articulos - a.n_articulos)
  .slice(0, 10);
const maxDias = Math.max(1, ...duraderos.map((a) => a.n_dias));

// --- 02 · Lo que dejó de contarse ------------------------------------------
// El corte de 2 días no es negociable: un asunto de un solo día que no continúa
// es lo normal de un diario, no un silencio. Sin ese filtro, esta superficie
// serían 162 filas de nada.
const apagados = asuntos
  .filter((a) => a.estado === "apagado" && a.n_dias >= 2)
  .sort((a, b) => b.n_dias - a.n_dias || b.n_articulos - a.n_articulos)
  .slice(0, 10);

// --- 03 · Cuánto dura un asunto, por sección -------------------------------
// Esto sustituye a los múltiplos de artículos por día. Mide la PERSISTENCIA de
// cada sección: en Política un asunto arrastra varios días; en Deportes, uno.
// Es una media, así que se declara sobre cuántos asuntos se ha calculado — sin
// la n, una media de 2 asuntos se lee igual que una de 40.
const porSeccion = new Map<string, { n: number; dias: number }>();
for (const a of asuntos) {
  const s = a.seccion ?? "sin-clasificar";
  const acc = porSeccion.get(s) ?? { n: 0, dias: 0 };
  acc.n += 1;
  acc.dias += a.n_dias;
  porSeccion.set(s, acc);
}
const MIN_MUESTRA = 3;
const persistencia = [...porSeccion.entries()]
  .filter(([, v]) => v.n >= MIN_MUESTRA)
  .map(([section, v]) => ({ section, n: v.n, media: v.dias / v.n }))
  // Orden editorial fijo, como la portada: en un periódico las secciones no se
  // recolocan según el dato del día.
  .sort((a, b) => pesoSeccion(a.section) - pesoSeccion(b.section));
const maxMedia = Math.max(1, ...persistencia.map((p) => p.media));

const dias = new Set(asuntos.flatMap((a) => [a.primer_dia, a.ultimo_dia])).size;

// La numeración se CALCULA: dos de las tres bandas son condicionales y con
// números a mano la página salía «01, 03» en cuanto una no se pintaba.
const bandasVisibles = [
  duraderos.length > 0 ? "dura" : null,
  apagados.length > 0 ? "apagados" : null,
  persistencia.length > 0 ? "persistencia" : null,
].filter((b): b is string => b !== null);
const numBanda = (id: string) => String(bandasVisibles.indexOf(id) + 1).padStart(2, "0");

const unDia = (n: number) => (n === 1 ? "1 día" : `${n} días`);
---

<Base
  title="La Doxa — tendencias"
  seccion="tendencias"
  edicion={`Tendencias · ${asuntos.length} asuntos seguidos`}
  descripcion="Cuánto dura la atención de la prensa española: los asuntos que siguen abiertos y los que dejaron de contarse."
>
  <section class="cifra-hero">
    <p class="cifra dato">{abiertos.length}</p>
    <p class="cifra-frase">
      asuntos abiertos ahora mismo. Esta página no cuenta noticias: cuenta cuánto aguanta cada
      asunto en la prensa — y cuáles se dejaron de contar sin cerrarse.
    </p>
  </section>

  {
    duraderos.length > 0 && (
      <>
        <div class="banda">
          <span class="banda-num">{numBanda("dura")}</span>
          <h2>Lo que más dura</h2>
          <span class="cuenta">días con piezas nuevas</span>
        </div>
        <p class="nota nota-deck">
          Un asunto es el mismo suceso contado a lo largo de varios días. Cuanto más dura, más
          tiempo ha sostenido la prensa la atención sobre él.
        </p>
        <ul class="filas-datos filas-datos-titular">
          {duraderos.map((a) => (
            <li>
              <span class="fila-etiqueta">
                <a href={urlAsunto(a.id)}>{a.titular ?? "Asunto sin titular contrastado"}</a>
              </span>
              <span class="fila-dato">
                <strong>{unDia(a.n_dias)}</strong>
                {` · ${a.n_articulos} piezas · ${a.n_medios} medios`}
              </span>
              <span class="celda-barra">
                <span
                  class="barra"
                  style={`inline-size: ${Math.round((a.n_dias / maxDias) * 100)}%`}
                />
              </span>
            </li>
          ))}
        </ul>
      </>
    )
  }

  {
    apagados.length > 0 && (
      <>
        <div class="banda">
          <span class="banda-num">{numBanda("apagados")}</span>
          <h2>Dejó de contarse</h2>
          <span class="cuenta">2+ días de cobertura, y nada desde entonces</span>
        </div>
        <p class="nota nota-deck">
          Asuntos que la prensa siguió varios días y ha dejado de mencionar. No quiere decir que
          se hayan resuelto: quiere decir que ya no aparecen.
        </p>
        <ul class="filas-datos filas-datos-titular">
          {apagados.map((a) => (
            <li>
              <span class="fila-etiqueta">
                <a href={urlAsunto(a.id)}>{a.titular ?? "Asunto sin titular contrastado"}</a>
              </span>
              <span class="fila-dato">
                <strong>{unDia(a.n_dias)}</strong>
                {` · última pieza el ${a.ultimo_dia} · ${a.n_medios} medios`}
              </span>
            </li>
          ))}
        </ul>
      </>
    )
  }

  {
    persistencia.length > 0 && (
      <>
        <div class="banda">
          <span class="banda-num">{numBanda("persistencia")}</span>
          <h2>Cuánto aguanta cada sección</h2>
          <span class="cuenta">duración media de un asunto</span>
        </div>
        <p class="nota nota-deck">
          Todas las barras van a la misma escala. Lo que se compara es cuántos días arrastra un
          asunto según de qué hable, no cuántos asuntos hay.
        </p>
        <ul class="filas-datos">
          {persistencia.map((p) => (
            <li>
              <span class="fila-etiqueta">
                <a href={urlSeccion(p.section)}>{rotula(p.section)}</a>
              </span>
              <span class="fila-dato">
                <strong>{p.media.toFixed(1)}</strong>
                {` días de media · sobre ${p.n} asuntos`}
              </span>
              <span class="celda-barra">
                <span
                  class="barra"
                  style={`inline-size: ${Math.round((p.media / maxMedia) * 100)}%`}
                />
              </span>
            </li>
          ))}
        </ul>
      </>
    )
  }

  {/* El pie va en columnas rotuladas que ocupan el marco, no en una cinta
      capada a la medida: a 1800 px un párrafo de `--measure` deja la página
      pegada al margen izquierdo (§ Páginas de datos). Nunca dos columnas en
      escritorio — serían 780 px por columna, 111 caracteres por línea. */}
  <div class="aparato aparato-3">
    <div>
      <p class="aparato-rotulo">Qué es un asunto</p>
      <p>
        El mismo suceso a lo largo de los días. Se agrupan comparando los artículos que las
        historias de cada día tienen en común, no por criterio editorial.
      </p>
    </div>
    <div>
      <p class="aparato-rotulo">Qué no distingue</p>
      <p>
        Por qué se apaga un asunto. Puede haberse resuelto, puede haber dejado de interesar o
        puede seguir abierto sin que nadie lo cuente. La cifra dice que no aparece, no por qué.
      </p>
    </div>
    <div>
      <p class="aparato-rotulo">La ventana</p>
      <p>
        {`${dias} días con datos. Un asunto vuelve a empezar si desaparece más de 48 horas: los
        días que se cuentan aquí son días seguidos con piezas, no apariciones sueltas.`}
      </p>
    </div>
  </div>
</Base>
