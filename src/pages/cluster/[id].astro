---
import Base from "../../layouts/Base.astro";
import Parrafos from "../../components/Parrafos.astro";
import Glosado from "../../components/Glosado.astro";
import Contrastar from "../../components/Contrastar.astro";
import Impacto from "../../components/Impacto.astro";
import {
  enLote,
  fechasHorneables,
  glosario,
  type Digest,
  type Historia,
  type TerminoGlosario,
} from "../../lib/api";
import { combinar, Marcador } from "../../lib/glosario";
import { rotula, urlSeccion } from "../../lib/ui";

// Macrostructure: 02 · Long Document — el relato se lee de corrido y el
// aparato de contraste cuelga de él. A partir de xl el aparato deja de
// colgar por debajo y se pone al margen (ver .doc en global.css): la prosa
// mantiene su medida y el lector ve quién cuenta qué SIN dejar de leer.

export async function getStaticPaths() {
  // Se hornean los clústeres de los digests dentro de la ventana. El resto
  // sigue en la DB: a ~48 clústeres/día, hornearlo todo no escala.
  // `enLote` y no `Promise.all`: son ~100 peticiones y abrirlas todas a la vez
  // hizo que el túnel devolviera 429 y tumbara el build (2026-08-13).
  const fechas = await fechasHorneables();
  const digests = await enLote<Digest>(fechas.map((f) => `/api/digest/${f}`));

  const ids = [
    ...new Set(digests.flatMap((d) => d.sections.flatMap((s) => s.clusters.map((c) => c.id)))),
  ];

  const historias = await enLote<Historia>(ids.map((id) => `/api/clusters/${id}`));

  // El diccionario se pide UNA vez para las ~500 páginas de historia y viaja
  // como prop: `getStaticPaths` corre una sola vez por build, así que pedirlo
  // aquí lo comparten todas sin repetir la petición por el túnel.
  const diccionario = await glosario();

  return historias.map((c) => ({ params: { id: String(c.id) }, props: { c, diccionario } }));
}

const { c, diccionario } = Astro.props as { c: Historia; diccionario: TerminoGlosario[] };
const s = c.synthesis;

// Los nombres que van en NEGRITA dentro del relato (Fase 14). Dos fuentes, y
// las dos son exactas — aquí no se adivina quién es un nombre propio:
//
//  1. Los MEDIOS del clúster. `synthesize.SYSTEM` obliga a que todo dato que no
//     compartan todos vaya atribuido dentro de la prosa («según ABC», «solo El
//     Mundo menciona»). Esa atribución es la regla que sostiene el producto y
//     hasta ahora era texto plano indistinguible del resto. Sale gratis y vale
//     para las 576 historias ya publicadas.
//  2. `entidades`, que la síntesis declara desde la Fase 14: personas y
//     organismos nombrados en el relato. Solo en síntesis nuevas; las viejas
//     se quedan con los medios, que ya es bastante.
const nombres = [...(c.media ?? []), ...(s?.entidades ?? [])];

// Una síntesis BREVE (Fase 14): historias de dos o tres medios, resumidas seis
// por llamada. Tienen relato y hechos comunes, pero NO análisis de divergencias
// —con dos versiones no hay encuadre que comparar—, así que la página no puede
// firmar «contraste» ni pintar el sello.
const esBreve = c.synthesis_kind === "breve";

// Un marcador POR PÁGINA: su memoria de "ya marcado" tiene que cruzar los
// párrafos del relato pero no filtrarse a la historia siguiente.
const marcador = new Marcador(combinar(diccionario, c.explicacion?.glosario ?? []), nombres);

// `hechos_divergentes` mezcla DOS cosas distintas, y llamarlas a las dos
// "contradicciones" engaña: en la base hay ~200 exclusivas por cada ~31
// desacuerdos reales. El discriminante es cuántos medios hay en `solo_en`:
//   1 medio  -> exclusiva: lo cuenta solo él (decisión editorial)
//  2+ medios -> contradicción: cada uno da una versión del MISMO hecho
const divs = s?.hechos_divergentes ?? [];
const contradicciones = divs.filter((d) => (d.solo_en ?? []).length > 1);
const exclusivas = divs.filter((d) => (d.solo_en ?? []).length === 1);
const comunes = s?.hechos_comunes ?? [];

// Tope de exclusivas. Medido el 2026-08-14 sobre las 15 síntesis del día: 73 de
// las 98 divergencias (74 %) eran exclusivas de un solo medio, y en los
// clústeres grandes son trivia —"La Vanguardia: seis o siete minutos", sobre el
// eclipse de 2027— porque un mega-clúster mezcla subhistorias que no comparten
// tema. Eran la mitad del alto de la página y ninguna era contraste.
const MAX_EXCLUSIVAS = 3;
const exclusivasVisibles = exclusivas.slice(0, MAX_EXCLUSIVAS);

// Las versiones originales, agrupadas por medio y con tope por medio. El
// eclipse traía 98 enlaces en una lista plana: para ir al original de ABC había
// que recorrer 22 de eldiario.es. Lo que el lector quiere es UNA versión del
// medio en el que confía, así que se enseñan las tres primeras de cada uno y el
// resto queda a un clic, sin perderse.
const MAX_POR_MEDIO = 3;
const porMedio = new Map<string, typeof c.articles>();
for (const a of c.articles ?? []) {
  if (!porMedio.has(a.medio)) porMedio.set(a.medio, []);
  porMedio.get(a.medio)!.push(a);
}
const medios = [...porMedio.entries()].map(([medio, arts]) => ({
  medio,
  visibles: arts.slice(0, MAX_POR_MEDIO),
  ocultas: arts.slice(MAX_POR_MEDIO),
}));
const nOcultas = medios.reduce((n, m) => n + m.ocultas.length, 0);

// Lo que se ve al compartir la historia. El arranque del relato dice más que
// cualquier plantilla; sin síntesis se cae al recuento de medios, que al menos
// es cierto. Se recorta por palabra: un corte a mitad de palabra canta.
const arranque = (s?.relato ?? "").replace(/\s+/g, " ").trim();
const descripcion = arranque
  ? arranque.length > 200
    ? arranque.slice(0, arranque.lastIndexOf(" ", 200)) + "…"
    : arranque
  : `Cómo cuentan esta noticia ${c.n_sources} medios, en ${c.n_articles} versiones.`;
---

<Base
  title={`${c.headline ?? "Historia"} — La Doxa`}
  edicion={`${rotula(c.section ?? "")} · ${c.digest_date ?? ""}`}
  descripcion={descripcion}
>
  <article class="doc">
    <div class="doc-cuerpo">
      <header class="doc-cabecera">
        <p class="doc-seccion">
          <a href={urlSeccion(c.section)}>{rotula(c.section ?? "—")}</a>
          {(c.topics ?? []).map((t) => <span class="tema">{t}</span>)}
        </p>
        <h1 class:list={{ prestado: !c.synthesis && c.titular_de }}>
          {c.headline ?? "Sin titular"}
        </h1>
        {
          !c.synthesis && c.titular_de && (
            <p class="doc-prestamo">
              Titular de <strong>{c.titular_de}</strong>. Esta historia está agrupada pero no
              contrastada: lo de arriba es el encuadre de un medio, no una síntesis de todos.
            </p>
          )
        }
        <p class="doc-meta">
          Contrastada entre <span class="dato">{c.n_sources}</span> medios sobre
          <span class="dato">{c.n_articles}</span> versiones ·
          <span class="dato">{c.digest_date}</span>
        </p>
      </header>

      {
        /* ⚠️ Este aviso decía «el presupuesto diario cubre las historias con más
           medios detrás», y era FALSO: el orden no lo da el número de medios,
           lo da `pipeline/relevancia.py`, que es cobertura DIVIDIDA por la
           antigüedad media. Se vio en el clúster 584 el 2026-08-19 —5 medios y
           17 versiones sin síntesis, mientras otras de 2 medios sí la tenían—,
           o sea que la página contradecía a la vista lo que ella misma decía.
           Si se cambia la fórmula, se cambia esta frase. */
        !s && (
          <p class="aviso">
            Esta historia está agrupada pero todavía no tiene síntesis. Cada día se redacta
            un número fijo de ellas, y el orden no lo da cuántos medios la cuentan sino esa
            cobertura dividida por lo vieja que es: una historia de tres medios de esta
            mañana pasa por delante de una de cinco repartida en varios días.
          </p>
        )
      }

      {
        s && (
          <>
            {s.relato && (
              <div class="relato">
                <Glosado texto={s.relato} marcador={marcador} />
              </div>
            )}

            {/* ⚠️ La firma dice qué se hizo, y en una breve NO se hizo
                contraste. Firmar «relato y contraste» sobre una historia de dos
                medios donde nadie buscó divergencias sería prometer un análisis
                que no existe — la misma regla que impide pintar «0
                contradicciones» ahí (§ El sello de una historia). */}
            <p class="firma-ia">
              {esBreve
                ? "Resumen redactado por un modelo de lenguaje a partir de los textos enlazados al margen. Esta historia la cuentan pocos medios, así que no hay contraste de versiones que medir. Puede contener errores: los originales mandan."
                : "Relato y contraste redactados por un modelo de lenguaje a partir de los textos enlazados al margen. Puede contener errores: los originales mandan."}
            </p>

            {comunes.length > 0 && (
              <>
                <h2 class="rotulo-doc">En qué coinciden todos</h2>
                <ul class="hechos">
                  {comunes.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              </>
            )}

            {contradicciones.length > 0 && (
              <>
                <h2 class="rotulo-doc">Dónde no cuadran las versiones</h2>
                {contradicciones.map((d) => (
                  <div class="divergencia">
                    <p class="divergencia-hecho">{d.hecho}</p>
                    <ul>
                      {(d.solo_en ?? []).map((x) => (
                        <li>{x}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </>
            )}

            {s.diferencias_de_encuadre && (
              <>
                <h2 class="rotulo-doc">Cómo lo encuadra cada medio</h2>
                <Parrafos texto={s.diferencias_de_encuadre} />
              </>
            )}

            {s.que_falta_por_saber && (
              <>
                <h2 class="rotulo-doc">Qué falta por saber</h2>
                <Parrafos texto={s.que_falta_por_saber} />
              </>
            )}
          </>
        )
      }
    </div>

    {/* Aparato del margen. Hasta el 2026-08-16 era solo atribución —quién la
        cuenta y qué cuenta solo uno—; desde la Fase 12 lleva además la lectura
        llana de la historia, por petición explícita del usuario ("debajo de
        las columnas de la derecha"). Ver design.md § En qué te afecta.
        Los dos bloques de atribución se pliegan, y el PRIMERO va abierto: una columna que
        Los dos bloques se pliegan, y el PRIMERO va abierto: una columna que
        empieza toda cerrada parece rota y esconde de qué va. Cuál es el primero
        depende del clúster —sin exclusivas, lo son las versiones—, así que el
        `open` se calcula, no se escribe fijo. */}
    <aside class="doc-aparato">
      {
        exclusivasVisibles.length > 0 && (
          <details class="pliegue" open>
            <summary class="rotulo-doc">
              Lo que solo cuenta un medio
              <span class="pliegue-cuenta">
                {
                  exclusivas.length > exclusivasVisibles.length
                    ? `${exclusivasVisibles.length} de ${exclusivas.length}`
                    : exclusivas.length
                }
              </span>
            </summary>
            <ul class="exclusivas">
              {exclusivasVisibles.map((d) => (
                <li>
                  <span class="exclusiva-medio">{d.solo_en![0]}</span>
                  <span>{d.hecho}</span>
                </li>
              ))}
            </ul>
            {exclusivas.length > exclusivasVisibles.length && (
              <p class="pliegue-nota">
                Se muestran {exclusivasVisibles.length} de {exclusivas.length}. Son datos que
                ningún otro medio recoge, no versiones enfrentadas.
              </p>
            )}
          </details>
        )
      }

      <details class="pliegue" open={exclusivasVisibles.length === 0}>
        <summary class="rotulo-doc">
          Las versiones originales
          <span class="pliegue-cuenta">{c.n_articles}</span>
        </summary>
        <div class="fuentes">
          {
            medios.map((m) => (
              <section class="fuente-grupo">
                <h3 class="fuente-medio">{m.medio}</h3>
                <ul>
                  {m.visibles.map((a) => (
                    <li>
                      <a href={a.url} target="_blank" rel="noopener noreferrer">
                        {a.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
        {
          nOcultas > 0 && (
            <details class="pliegue pliegue-interior">
              <summary class="rotulo-doc">Y {nOcultas} versiones más</summary>
              <div class="fuentes">
                {medios
                  .filter((m) => m.ocultas.length > 0)
                  .map((m) => (
                    <section class="fuente-grupo">
                      <h3 class="fuente-medio">{m.medio}</h3>
                      <ul>
                        {m.ocultas.map((a) => (
                          <li>
                            <a href={a.url} target="_blank" rel="noopener noreferrer">
                              {a.title}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </section>
                  ))}
              </div>
            </details>
          )
        }
      </details>

      {
        /* No se pliega, a diferencia de sus vecinos: es lo que más falta le
           hace a quien no sigue la actualidad, y esconderlo tras un clic
           contradice el motivo de escribirlo. Sin explicación no se pinta
           nada — la etapa `explicar` solo pasa por las historias sintetizadas
           en modo contraste, y un hueco es más honesto que un placeholder.

           ⚠️ Se comprueba `impacto` y NO `explicacion` a secas: desde el
           2026-08-20 una historia BREVE puede tener explicación con SOLO
           `fuentes` («para contrastarlo» sí, «en qué te afecta» no — ver
           pipeline/explicar.py). Con la comprobación antigua saldrían cuatro
           filas vacías y un sello de alcance inventado. */
        c.explicacion?.impacto && <Impacto explicacion={c.explicacion} />
      }
      {
        /* «Para contrastarlo» va DEBAJO de «en qué te afecta» y por el mismo
           criterio que puso a ese bloque el último: primero qué significa esto
           para ti, y solo después dónde comprobarlo. Quien quiere comprobar
           llega hasta abajo; quien solo quiere entender no tiene que pasar por
           encima de una lista de enlaces institucionales. */
        c.explicacion?.fuentes?.length ? <Contrastar fuentes={c.explicacion.fuentes} /> : null
      }
    </aside>
  </article>
</Base>
