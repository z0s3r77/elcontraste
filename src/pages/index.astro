---
import Base from "../layouts/Base.astro";
import Banda from "../components/Banda.astro";
import Ficha from "../components/Ficha.astro";
import { digestUltimo, traer, type FichaCluster } from "../lib/api";
import { rotula, urlCluster, urlSeccion } from "../lib/ui";

// Macrostructure: 20 · Ecosystem Index — varias superficies de descubrimiento.
// Sin thumbnails: el proyecto no almacena imágenes (higiene legal). El índice
// es tipográfico y la densidad la da la retícula.

const digest = await digestUltimo();

const todas: FichaCluster[] = digest.sections.flatMap((s) =>
  s.clusters.map((c) => ({ ...c, section: s.section })),
);

// Superficie 1: manda la RELEVANCIA que calcula la API — cobertura ponderada
// por la edad media de los artículos (ver `pipeline/relevancia.py`). Aquí se
// reordena porque la portada mezcla secciones y la API solo ordena dentro de
// cada una; el criterio, en cambio, no se reinventa.
//
// ⚠️ Hasta el 2026-08-14 esta línea ordenaba por `n_sources`, y con eso el
// clúster del eclipse abrió el sitio tres días seguidos: daba igual lo que
// hiciera el backend, la portada lo deshacía. Si `relevancia` llegara nula
// —una API vieja— se cae a `n_sources`, que es el comportamiento anterior.
const peso = (c: FichaCluster) => c.relevancia ?? c.n_sources;
const portada = [...todas].sort((a, b) => peso(b) - peso(a));
const lead = portada[0];
// Seis, no cuatro: a partir de xl la columna lateral se parte en dos, y con
// cuatro fichas quedaban dos columnas cortas al lado de una apertura alta.
const secundarias = portada.slice(1, 7);
// La apertura es alta pero no tanto como dos columnas de seis fichas, así que
// la columna 1 sigue con piezas menores en vez de dejar un hueco. Es lo que
// hace un periódico: bajo la apertura no hay papel en blanco.
const continuacion = portada.slice(7, 9);

// Superficie 3: cobertura diferencial. Es un extra — si falla, la portada
// sigue en pie. Lo que NO puede fallar en silencio es el digest (ver api.ts).
type Hueco = { id: number; headline: string | null; covered_by: string };
let huecos: Hueco[] = [];
try {
  huecos = await traer<Hueco[]>("/api/coverage-gap?days=7");
} catch {
  huecos = [];
}
---

<Base
  title="La Doxa — portada"
  seccion="hoy"
  edicion={`Edición del ${digest.date} · ${digest.n_clusters} historias`}
>
  <p class="posicionamiento">
    Cada historia, contada por todos los medios que la cuentan. Lo que coinciden,
    lo que solo dice uno, y lo que ninguno aclara.
  </p>

  <section class="superficie">
    <Banda i={0} titulo="Lo más contrastado" cuenta={`${todas.length} historias del día`} />
    <div class="apertura">
      <div class="apertura-principal">
        <Ficha c={lead} destacada />
        {continuacion.map((c) => <Ficha c={c} />)}
      </div>
      <div class="apertura-lateral">
        {secundarias.map((c) => <Ficha c={c} />)}
      </div>
    </div>
  </section>

  <section class="superficie">
    <Banda i={1} titulo="Por sección" cuenta={`${digest.sections.length} bloques`} />
    <div class="rejilla-secciones">
      {
        digest.sections.map((s) => (
          <div class="columna-seccion">
            <h3 class="rotulo-seccion">
              <a href={urlSeccion(s.section)}>{rotula(s.section)}</a>
              <span class="dato muted">{s.clusters.length}</span>
            </h3>
            <ul class="lista-titulares">
              {s.clusters.slice(0, 6).map((c) => (
                <li>
                  <a
                    href={urlCluster(c.id)}
                    class:list={{ prestado: !c.has_synthesis && c.titular_de }}
                    title={!c.has_synthesis && c.titular_de
                      ? `Titular de ${c.titular_de} — esta historia todavía no tiene síntesis`
                      : undefined}
                  >
                    {c.headline ?? "Sin titular"}
                  </a>
                  <span class="dato muted">{c.n_sources}m</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  {
    huecos.length > 0 && (
      <section class="superficie">
        <Banda i={2} titulo="Lo cuenta un solo bloque" cuenta={`${huecos.length} en 7 días`} />
        <p class="nota">
          Historias que un bloque editorial cubre y el otro ignora por completo. No es cómo lo
          cuentan: es qué existe para unos y no para otros.
        </p>
        <ul class="lista-huecos">
          {huecos.slice(0, 8).map((h) => (
            <li>
              <span class={`marca-bloque marca-${h.covered_by}`}>{h.covered_by}</span>
              <a href={urlCluster(h.id)}>{h.headline ?? "Sin titular"}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

