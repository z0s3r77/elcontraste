---
import Base from "../layouts/Base.astro";
import Banda from "../components/Banda.astro";
import Ficha from "../components/Ficha.astro";
import BloqueSeccion from "../components/BloqueSeccion.astro";
import {
  digestUltimo,
  resumenUltimo,
  traer,
  type Asunto,
  type FichaCluster,
} from "../lib/api";
import {
  fraseAusentes,
  numeral,
  pesoSeccion,
  rotula,
  urlAsunto,
  urlCluster,
  urlResumen,
} from "../lib/ui";

// Macrostructure: 20 · Ecosystem Index — varias superficies de descubrimiento.
// Sin thumbnails: el proyecto no almacena imágenes (higiene legal). El índice
// es tipográfico y la densidad la da la retícula.
//
// ── Rehecha en la Fase 13 (2026-08-18) ───────────────────────────────────────
// Diagnóstico del usuario: «entras y nada te llama la atención», «simplemente se
// toman las noticias y ya». Tres cosas medidas sobre el digest de ese día antes
// de tocar nada:
//
//   1. La página abría con un párrafo centrado sobre el nombre del sitio y nada
//      más. NADA decía qué día era hoy.
//   2. La apertura la elegía la relevancia, que es COBERTURA ponderada. El
//      resultado abría con «El juez Pedraz ordena un nuevo volcado del teléfono
//      de Juanma Serrano» mientras el resumen del día —en otra página— abría con
//      «Ola de calor extremo con avisos rojos y 44 grados… evita salir entre las
//      13:00 y las 21:00». El sitio escondía lo mejor que tenía.
//   3. El sello no podía decir casi nunca nada: de 18 síntesis, CERO tenían
//      contradicciones.
//
// De ahí las cinco superficies de ahora, y el orden no es negociable
// (§ Portada de design.md):
//
//   00  Estado del día     — cifras de asuntos + el titular del resumen
//   01  Lo que te toca hoy — los puntos del resumen, con su «por qué importa»
//   02  Asuntos vivos      — lo que se sigue, con el día que va
//   03  Por sección        — el día entero, en orden editorial fijo
//   04  Lo cuenta un solo bloque — la cobertura diferencial
const [digest, resumen] = await Promise.all([digestUltimo(), resumenUltimo()]);

const todas: FichaCluster[] = digest.sections.flatMap((s) =>
  s.clusters.map((c) => ({ ...c, section: s.section })),
);
const porId = new Map(todas.map((c) => [c.id, c]));

// --- 00 · Estado del día -----------------------------------------------------
//
// Las cifras son de ASUNTOS, no de artículos rastreados. Es la misma regla que
// ya obligó a retirar la gráfica de totales de Tendencias el 2026-08-16: la
// cifra que manda tiene que ser del lector, y «429 artículos rastreados» habla
// del rastreador. «6 asuntos nuevos, 14 que siguen» habla del día.
//
// 🔑 Hasta la Fase 14 estas tres cifras se pintaban a 3 rem en la columna
// derecha de la primera pantalla. Se retiraron por una razón concreta: NO
// LLEVABAN A NINGÚN SITIO, y no podían — no existe página `/asuntos/`, y
// `/asunto/{id}/` solo se hornea con `min_dias >= 2`, así que «44 asuntos
// nuevos» no tiene destino posible. Media pantalla ocupada por tres números
// que el lector no puede usar. Ahora son una línea de apoyo bajo la entradilla.
//
// ⚠️ `apagados` se cae de la línea. Es la cifra que ya obligó a reescribir su
// SQL por leerse como «139 asuntos han muerto hoy» (Fase 13), y en una línea
// corrida no queda sitio para explicar que son solo los que acaban de cruzar
// la raya. Una cifra que necesita nota al pie no cabe en un pie de entradilla.
const a = digest.asuntos;
// ⚠️ Frases enteras: Astro se come el espacio entre dos interpolaciones
// contiguas y saldría «6nuevos» (visto en el HTML horneado, no en el editor).
const cifras = [
  `${digest.n_clusters} ${digest.n_clusters === 1 ? "historia" : "historias"}`,
  ...(a
    ? [
        `${a.nuevos} ${a.nuevos === 1 ? "asunto nuevo" : "asuntos nuevos"}`,
        `${a.siguen} ${a.siguen === 1 ? "viene de antes" : "vienen de antes"}`,
      ]
    : []),
].join(" · ");

// --- 01 · Lo que te toca hoy -------------------------------------------------
//
// El orden lo elige el modelo viendo el día entero, con lo inmediato y lo
// práctico primero (ver pipeline/briefing.py). NO es el orden de la portada
// anterior, que era cobertura ponderada.
//
// Si el resumen falta —es una etapa que puede caerse sola sin tumbar la pasada—
// la portada NO se queda sin apertura: cae a las tres de más relevancia, que es
// exactamente lo que hacía antes. Una etapa caída no puede dejar la página sin
// primera pantalla.
const URGENCIA: Record<string, string> = {
  ahora: "Ya está pasando",
  pronto: "Se decide estos días",
  fondo: "Asunto de fondo",
};

const puntos = (resumen?.puntos ?? []).map((p) => ({
  ...p,
  ficha: porId.get(p.cluster_id) ?? null,
}));

const peso = (c: FichaCluster) => c.relevancia ?? c.n_sources;
const respaldo = puntos.length === 0 ? [...todas].sort((x, y) => peso(y) - peso(x)).slice(0, 3) : [];

// --- 02 · Asuntos vivos ------------------------------------------------------
//
// Lo que el sitio no podía enseñar hasta la Fase 13: qué se está siguiendo y
// desde cuándo. `min_dias=2` porque un asunto de un solo día no se «sigue».
// Es un extra: si falla, la portada sigue en pie (lo que NO puede fallar en
// silencio es el digest — ver `digestUltimo` en lib/api.ts).
let vivos: Asunto[] = [];
try {
  vivos = await traer<Asunto[]>("/api/asuntos?estado=sigue&min_dias=2&limit=6");
} catch {
  vivos = [];
}

// --- 04 · Lo cuenta un solo bloque ------------------------------------------
//
// 🔑 Aquí vivían ~35 líneas de parche (`VACIAS`, `terminos`, `mismaHistoria`,
// `primeras`) que descartaban variantes del mismo suceso comparando el solape de
// términos del titular. Existían por una sola razón: la ventana es de 7 días, el
// mismo suceso se reagrupaba cada día y sin memoria cinco de las ocho filas eran
// DOS historias (los Lakers tres veces, el Pazo de Meirás dos).
//
// Con los asuntos eso se agrupa por `hilo.id`, que es EXACTO y no una heurística
// con un 0,6 dentro. El rediseño borra código.
type Hueco = FichaCluster & {
  covered_by: "izquierda" | "derecha";
  digest_date: string;
};
let huecos: Hueco[] = [];
try {
  huecos = await traer<Hueco[]>("/api/coverage-gap?days=7");
} catch {
  huecos = [];
}

/** Una fila por asunto. La lista llega ordenada por cobertura desde la API, así
 *  que la primera de cada asunto es la versión con más medios. */
const unaPorAsunto = (lista: Hueco[], n: number) => {
  const vistos = new Set<string>();
  const out: Hueco[] = [];
  for (const h of lista) {
    // Sin asunto (la etapa de hilos aún no ha pasado por él) cae a su propio id:
    // no se agrupa, pero tampoco se pierde.
    const clave = h.hilo ? `h${h.hilo.id}` : `c${h.id}`;
    if (vistos.has(clave)) continue;
    vistos.add(clave);
    out.push(h);
    if (out.length === n) break;
  }
  return out;
};

const POR_BLOQUE = 6;
const bloques = (["izquierda", "derecha"] as const).map((lado) => {
  const suyas = huecos.filter((h) => h.covered_by === lado);
  return { lado, total: suyas.length, huecos: unaPorAsunto(suyas, POR_BLOQUE) };
});

// --- 03 · Por sección --------------------------------------------------------
//
// Nada se repite entre superficies: lo que ha subido a la apertura no vuelve a
// salir en su bloque. A dos pantallas de distancia, la repetición se lee como un
// fallo y no como una portada.
const enApertura = new Set<number>([
  ...puntos.map((p) => p.cluster_id),
  ...respaldo.map((c) => c.id),
]);
const secciones = digest.sections
  .map((s) => ({
    section: s.section,
    clusters: s.clusters.filter((c) => !enApertura.has(c.id)),
    total: s.clusters.length,
  }))
  .filter((s) => s.clusters.length > 0)
  .sort((x, y) => pesoSeccion(x.section) - pesoSeccion(y.section));
---

<Base
  title="La Doxa — portada"
  seccion="hoy"
  edicion={`Edición del ${digest.date} · ${digest.n_clusters} historias`}
>
  {/* El lema explica el nombre y lo que se pretende con él: doxa es la
      opinión, lo que se cree saber, frente a episteme. El sitio no promete la
      versión verdadera —no la tiene—, sino todas las versiones juntas para que
      el criterio salga de compararlas.

      Va PRIMERO y centrado, colgando de la cabecera, que también lo está. La
      Fase 13 lo bajó a la última línea del estado del día y en escritorio lo
      alineó a la izquierda; el resultado es que dejó de verse centrado en
      cualquier ancho pese a que design.md seguía diciendo que lo estaba. */}
  <p class="posicionamiento">
    Doxa es la opinión, no el saber. Todas las versiones de una misma noticia, juntas, para que
    el criterio sea tuyo.
  </p>

  {/* 00 · Estado del día. Va sobre el pliegue, así que entra por CSS y NO
      entra en el revelado por scroll: ocultar la primera pantalla hasta que
      corra un script retrasa el LCP y deja la portada en blanco si el JS falla
      (§ Motion de design.md). */}
  <section class="estado">
    {
      resumen?.titular_del_dia && (
        <div class="estado-lede">
          <h2>{resumen.titular_del_dia}</h2>
          {resumen.entradilla && <p class="nota-deck">{resumen.entradilla}</p>}
        </div>
      )
    }
    <p class="estado-cifras">{cifras}</p>
  </section>

  <section class="superficie">
    <Banda
      i={0}
      titulo={puntos.length > 0 ? "Lo que te toca hoy" : "Lo más importante del día"}
      cuenta={`${todas.length} historias`}
    />
    {
      puntos.length > 0 ? (
        <>
          <p class="nota nota-deck">
            De todo lo de hoy, lo que cambia algo ya y a quién le llega. Lo inmediato primero, no
            lo más cubierto. <a href={urlResumen()}>Se puede escuchar →</a>
          </p>
          <ol class="toca">
            {puntos.map((p, i) => (
              <li class="toca-punto">
                <p class="toca-linea">
                  <span class="banda-num">{numeral(i)}</span>
                  <span class:list={["resumen-urgencia", `urg-${p.urgencia}`]}>
                    {URGENCIA[p.urgencia] ?? p.urgencia}
                  </span>
                  {p.section && <span class="resumen-seccion">{rotula(p.section)}</span>}
                  {p.ficha?.hilo && p.ficha.hilo.n_dias >= 2 && (
                    <a class="toca-dia" href={urlAsunto(p.ficha.hilo.id)}>
                      {`Día ${p.ficha.hilo.dia} de este asunto`}
                    </a>
                  )}
                </p>
                <h3 class="toca-titulo">
                  <a href={urlCluster(p.cluster_id)}>{p.titulo}</a>
                </h3>
                <p class="toca-porque">{p.por_que_importa}</p>
              </li>
            ))}
          </ol>
        </>
      ) : (
        <div class="apertura">
          <div class="apertura-principal">{respaldo[0] && <Ficha c={respaldo[0]} destacada />}</div>
          <div class="apertura-lateral">
            {respaldo.slice(1).map((c) => (
              <Ficha c={c} />
            ))}
          </div>
        </div>
      )
    }
  </section>

  {
    vivos.length > 0 && (
      <section class="superficie">
        <Banda i={1} titulo="Asuntos que siguen" cuenta={`${vivos.length} en curso`} />
        <p class="nota nota-deck">
          Historias que no se acaban en un día. Aquí se ven enteras: desde cuándo vienen, cuántos
          medios las cuentan y quién ha dejado de hacerlo.
        </p>
        <ul class="asuntos-vivos">
          {vivos.map((v) => (
            <li class="asunto-fila">
              <a class="asunto-titular" href={urlAsunto(v.id)}>
                {v.titular ?? "Asunto sin titular contrastado"}
              </a>
              <p class="asunto-cifras">
                <span class="dato asunto-dias">{`${v.n_dias} días`}</span>
                <span class="dato">{`${v.n_medios} medios`}</span>
                <span class="dato">{`${v.n_articulos} piezas`}</span>
                {fraseAusentes(v.no_lo_cuentan) && (
                  <span class="dato muted">{fraseAusentes(v.no_lo_cuentan)}</span>
                )}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="superficie">
    <Banda i={2} titulo="Por sección" cuenta={`${secciones.length} bloques`} />
    <div class="rejilla-bloques">
      {
        secciones.map((s) => (
          <BloqueSeccion seccion={s.section} clusters={s.clusters} total={s.total} />
        ))
      }
    </div>
  </section>

  {
    huecos.length > 0 && (
      <section class="superficie">
        <Banda i={3} titulo="Lo cuenta un solo bloque" cuenta={`${huecos.length} en 7 días`} />
        <p class="nota nota-deck">
          Historias que un bloque editorial cubre y el otro ignora por completo. No es cómo lo
          cuentan: es qué existe para unos y no para otros.
        </p>
        <div class="huecos">
          {bloques.map(({ lado, total, huecos: suyas }) => (
            <div class="huecos-bloque">
              <h3 class="rotulo-seccion">
                <span>Solo en medios de {lado}</span>
                <span class="dato muted">{total}</span>
              </h3>
              {suyas.length === 0 ? (
                <p class="nota">Ninguna en los últimos 7 días.</p>
              ) : (
                <ul class="lista-huecos">
                  {suyas.map((h) => (
                    <li>
                      <a href={urlCluster(h.id)}>{h.headline ?? "Sin titular"}</a>
                      <span class="dato muted">{h.digest_date}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </section>
    )
  }
</Base>
