---
import Base from "../layouts/Base.astro";
import Banda from "../components/Banda.astro";
import Ficha from "../components/Ficha.astro";
import BloqueSeccion from "../components/BloqueSeccion.astro";
import { digestUltimo, traer, type FichaCluster } from "../lib/api";
import { pesoSeccion, urlCluster } from "../lib/ui";

// Macrostructure: 20 · Ecosystem Index — varias superficies de descubrimiento.
// Sin thumbnails: el proyecto no almacena imágenes (higiene legal). El índice
// es tipográfico y la densidad la da la retícula.
//
// Rehecha el 2026-08-16. Antes eran dos superficies planas —una apertura de 9
// historias y una rejilla de titulares pelados— y las dos tenían el mismo
// problema: la portada no decía de qué iba cada cosa ni cuánto contraste tenía.
// Ahora la sección es la unidad de lectura, con su propia apertura escrita.

const digest = await digestUltimo();

const todas: FichaCluster[] = digest.sections.flatMap((s) =>
  s.clusters.map((c) => ({ ...c, section: s.section })),
);

// Superficie 1: manda la RELEVANCIA que calcula la API — cobertura ponderada
// por la edad media Y por la novedad (ver `pipeline/relevancia.py`). Aquí se
// reordena porque la portada mezcla secciones y la API solo ordena dentro de
// cada una; el criterio, en cambio, no se reinventa.
//
// ⚠️ Hasta el 2026-08-14 esta línea ordenaba por `n_sources`, y con eso el
// clúster del eclipse abrió el sitio tres días seguidos: daba igual lo que
// hiciera el backend, la portada lo deshacía. Si `relevancia` llegara nula
// —una API vieja— se cae a `n_sources`, que es el comportamiento anterior.
const peso = (c: FichaCluster) => c.relevancia ?? c.n_sources;
const portada = [...todas].sort((a, b) => peso(b) - peso(a));

// Tres, no nueve: la apertura responde "¿qué ha pasado hoy?" y el resto del
// día se lee por secciones, que es lo que el lector pidió. Una apertura larga
// vuelve a ser la lista plana que se acaba de quitar.
const apertura = portada.slice(0, 3);
const lead = apertura[0];
const secundarias = apertura.slice(1);

// Superficie 2: las secciones, en orden EDITORIAL fijo (ui.ts) y no por
// volumen. Las historias de la apertura se quitan de sus bloques: repetirlas a
// dos pantallas de distancia se lee como un fallo, no como una portada.
const enApertura = new Set(apertura.map((c) => c.id));
const secciones = digest.sections
  .map((s) => ({
    section: s.section,
    clusters: s.clusters.filter((c) => !enApertura.has(c.id)),
    total: s.clusters.length,
  }))
  .filter((s) => s.clusters.length > 0)
  .sort((a, b) => pesoSeccion(a.section) - pesoSeccion(b.section));

// Superficie 3: cobertura diferencial. Es un extra — si falla, la portada
// sigue en pie. Lo que NO puede fallar en silencio es el digest (ver api.ts).
type Hueco = {
  id: number;
  headline: string | null;
  covered_by: "izquierda" | "derecha";
  digest_date: string;
};
let huecos: Hueco[] = [];
try {
  huecos = await traer<Hueco[]>("/api/coverage-gap?days=7");
} catch {
  huecos = [];
}

// El mismo suceso se vuelve a agrupar cada día de la ventana de 7, así que un
// hueco duradero llega aquí hasta cinco veces con titulares casi iguales. Sin
// filtrar, cinco de las ocho filas de la superficie eran DOS historias (la
// venta de los Lakers, tres veces; el Pazo de Meirás, dos). Se comparan los
// términos con peso: solapamiento sobre el titular más corto, porque las
// variantes del mismo día se diferencian en que una añade cola ("…, menos de
// un año después de su anterior compraventa") y Jaccard las separaría.
const VACIAS = new Set(
  "de del la el los las en y a por que un una con al para su sus se lo como más".split(" "),
);
const terminos = (t: string) =>
  new Set(
    t
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, " ")
      .split(" ")
      .filter((p) => p.length > 2 && !VACIAS.has(p)),
  );
const mismaHistoria = (a: Set<string>, b: Set<string>) => {
  const comunes = [...a].filter((p) => b.has(p)).length;
  return comunes / Math.min(a.size, b.size) >= 0.6;
};

/** Las `n` primeras del bloque, sin repetir historia. La lista llega ordenada
 *  por cobertura desde la API: quedarse con la primera de cada grupo conserva
 *  la versión con más medios. */
const primeras = (lista: Hueco[], n: number) => {
  const vistas: Set<string>[] = [];
  const out: Hueco[] = [];
  for (const h of lista) {
    const t = terminos(h.headline ?? "");
    if (t.size === 0 || vistas.some((v) => mismaHistoria(t, v))) continue;
    vistas.push(t);
    out.push(h);
    if (out.length === n) break;
  }
  return out;
};

// Un bloque por columna, y la columna de la izquierda es la de la izquierda.
// La posición dice lo que antes decía un chip repetido en cada fila.
const POR_BLOQUE = 6;
const bloques = (["izquierda", "derecha"] as const).map((lado) => {
  const suyas = huecos.filter((h) => h.covered_by === lado);
  return { lado, total: suyas.length, huecos: primeras(suyas, POR_BLOQUE) };
});
---

<Base
  title="La Doxa — portada"
  seccion="hoy"
  edicion={`Edición del ${digest.date} · ${digest.n_clusters} historias`}
>
  <!-- El lema explica el nombre y lo que se pretende con él: doxa es la
       opinión, lo que se cree saber, frente a episteme. El sitio no promete la
       versión verdadera —no la tiene—, sino todas las versiones juntas para
       que el criterio salga de compararlas. -->
  <p class="posicionamiento">
    Doxa es la opinión, no el saber. Todas las versiones de una misma noticia,
    juntas, para que el criterio sea tuyo.
  </p>

  <section class="superficie">
    <Banda i={0} titulo="Lo más importante del día" cuenta={`${todas.length} historias`} />
    <div class="apertura">
      <div class="apertura-principal">
        <Ficha c={lead} destacada />
      </div>
      <div class="apertura-lateral">
        {secundarias.map((c) => <Ficha c={c} />)}
      </div>
    </div>
  </section>

  <section class="superficie">
    <Banda i={1} titulo="Por sección" cuenta={`${secciones.length} bloques`} />
    <div class="rejilla-bloques">
      {
        secciones.map((s) => (
          <BloqueSeccion seccion={s.section} clusters={s.clusters} total={s.total} />
        ))
      }
    </div>
  </section>

  {
    huecos.length > 0 && (
      <section class="superficie">
        <Banda i={2} titulo="Lo cuenta un solo bloque" cuenta={`${huecos.length} en 7 días`} />
        <p class="nota nota-deck">
          Historias que un bloque editorial cubre y el otro ignora por completo. No es cómo lo
          cuentan: es qué existe para unos y no para otros.
        </p>
        <div class="huecos">
          {bloques.map(({ lado, total, huecos: suyas }) => (
            <div class="huecos-bloque">
              <h3 class="rotulo-seccion">
                <span>Solo en medios de {lado}</span>
                <span class="dato muted">{total}</span>
              </h3>
              {suyas.length === 0 ? (
                <p class="nota">Ninguna en los últimos 7 días.</p>
              ) : (
                <ul class="lista-huecos">
                  {suyas.map((h) => (
                    <li>
                      <a href={urlCluster(h.id)}>{h.headline ?? "Sin titular"}</a>
                      <span class="dato muted">{h.digest_date}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </section>
    )
  }
</Base>
