---
import Base from "../layouts/Base.astro";
// Macrostructure: 20 · Ecosystem Index — varias superficies de descubrimiento.
// Sin thumbnails: el proyecto no almacena imágenes (higiene legal). El índice
// es tipográfico y la densidad la da la retícula.
---

<Base title="El Contraste — portada" seccion="hoy">
  <p class="posicionamiento">
    Cada historia, contada por todos los medios que la cuentan. Lo que coinciden,
    lo que solo dice uno, y lo que ninguno aclara.
  </p>

  <div id="portada"><p class="estado">Componiendo la portada…</p></div>
</Base>

<script>
  import { esc, traer, rotula, numeral, ficha } from "../lib/ui";

  const $ = (id: string) => document.getElementById(id)!;

  function banda(i: number, titulo: string, cuenta: string, cuerpo: string, mas?: string) {
    return `
      <section class="superficie">
        <div class="banda">
          <span class="banda-num">${numeral(i)}</span>
          <h2>${esc(titulo)}</h2>
          <span class="cuenta">${esc(cuenta)}</span>
        </div>
        ${cuerpo}
        ${mas ? `<p class="mas"><a class="enlace-accion" href="${mas}">Ver todo →</a></p>` : ""}
      </section>`;
  }

  async function main() {
    const raiz = $("portada");
    try {
      const digest: any = await traer("/api/digest/latest");

      $("mast-edicion").textContent =
        `Edición del ${digest.date} · ${digest.n_clusters} historias`;

      const todas = digest.sections.flatMap((s: any) =>
        s.clusters.map((c: any) => ({ ...c, section: s.section })),
      );

      // ── Superficie 1: la portada propiamente dicha.
      // Criterio: más medios = más contrastada. No hay "editor" que elija.
      const portada = [...todas].sort((a, b) => b.n_sources - a.n_sources);
      const lead = portada[0];
      const secundarias = portada.slice(1, 5);

      const superficie1 = lead
        ? `<div class="apertura">
             ${ficha(lead, true)}
             <div class="apertura-lateral">
               ${secundarias.map((c: any) => ficha(c)).join("")}
             </div>
           </div>`
        : `<p class="estado">Sin historias hoy.</p>`;

      // ── Superficie 2: por sección, cada una su columna.
      const porSeccion = digest.sections
        .map(
          (s: any) => `
          <div class="columna-seccion">
            <h3 class="rotulo-seccion">
              <a href="/seccion?s=${encodeURIComponent(s.section)}">${esc(rotula(s.section))}</a>
              <span class="dato muted">${s.clusters.length}</span>
            </h3>
            <ul class="lista-titulares">
              ${s.clusters
                .slice(0, 6)
                .map(
                  (c: any) => `
                <li>
                  <a href="/cluster?id=${encodeURIComponent(c.id)}">${esc(
                    c.headline ?? "(sin titular todavía)",
                  )}</a>
                  <span class="dato muted">${c.n_sources}m</span>
                </li>`,
                )
                .join("")}
            </ul>
          </div>`,
        )
        .join("");

      raiz.innerHTML =
        banda(0, "Lo más contrastado", `${todas.length} historias del día`, superficie1) +
        banda(1, "Por sección", `${digest.sections.length} bloques`, `<div class="rejilla-secciones">${porSeccion}</div>`) +
        `<div id="huecos"></div>`;

      // ── Superficie 3: cobertura diferencial. Va aparte porque es la que más
      // tarda y no debe bloquear el pintado de la portada.
      try {
        const huecos: any[] = await traer("/api/coverage-gap?days=7");
        if (huecos.length) {
          $("huecos").innerHTML = banda(
            2,
            "Lo cuenta un solo bloque",
            `${huecos.length} en 7 días`,
            `<p class="nota">Historias que un bloque editorial cubre y el otro ignora por
             completo. No es cómo lo cuentan: es qué existe para unos y no para otros.</p>
             <ul class="lista-huecos">
               ${huecos
                 .slice(0, 8)
                 .map(
                   (h: any) => `
                 <li>
                   <span class="marca-bloque marca-${esc(h.covered_by)}">${esc(h.covered_by)}</span>
                   <a href="/cluster?id=${encodeURIComponent(h.id)}">${esc(
                     h.headline ?? "(sin titular todavía)",
                   )}</a>
                 </li>`,
                 )
                 .join("")}
             </ul>`,
          );
        }
      } catch {
        /* La cobertura diferencial es un extra: si falla, la portada sigue en pie. */
      }
    } catch (err) {
      raiz.innerHTML = `<p class="estado">No se pudo cargar la portada: ${esc(err)}</p>`;
    }
  }
  main();
</script>

<style is:global>
  .posicionamiento {
    max-width: 52ch;
    margin: 0 0 var(--space-lg);
    font-size: var(--text-lg);
    line-height: 1.4;
    color: var(--color-muted);
  }

  .superficie { margin-bottom: var(--space-xl); }
  .mas { margin: var(--space-sm) 0 0; }
  .nota {
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-neutral);
    margin: 0 0 var(--space-sm);
  }

  /* Apertura: la pieza mayor manda, las secundarias hacen de columna lateral. */
  .apertura {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--space-lg);
  }
  .apertura-lateral {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
    border-left: var(--rule-hair) solid var(--color-rule);
    padding-left: var(--space-lg);
  }

  .apertura-lateral .ficha + .ficha {
    border-top: var(--rule-hair) solid var(--color-rule);
    padding-top: var(--space-sm);
  }

  /* Rejilla de secciones: columnas de periódico, no tarjetas. */
  .rejilla-secciones {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-lg);
  }
  .rotulo-seccion {
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border-bottom: var(--rule-hair) solid var(--color-rule);
    padding-bottom: var(--space-3xs);
    margin: 0 0 var(--space-2xs);
    display: flex; justify-content: space-between; gap: var(--space-2xs);
  }
  .rotulo-seccion a { color: var(--color-ink); text-decoration: none; }
  .rotulo-seccion a:hover { color: var(--color-accent); }
  .lista-titulares { list-style: none; margin: 0; padding: 0; }
  .lista-titulares li {
    display: flex; gap: var(--space-2xs); align-items: baseline;
    padding: var(--space-3xs) 0;
    border-bottom: var(--rule-hair) dotted var(--color-rule);
    font-size: var(--text-sm);
    line-height: 1.35;
  }
  .lista-titulares a {
    color: var(--color-ink); text-decoration: none; overflow-wrap: anywhere;
  }
  .lista-titulares a:hover { color: var(--color-accent); text-decoration: underline; }
  .lista-titulares .dato { margin-left: auto; font-size: var(--text-xs); }

  .lista-huecos { list-style: none; margin: 0; padding: 0; max-width: var(--measure); }
  .lista-huecos li {
    display: flex; gap: var(--space-2xs); align-items: baseline;
    padding: var(--space-3xs) 0;
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  .lista-huecos a { color: var(--color-ink); text-decoration: none; }
  .lista-huecos a:hover { color: var(--color-accent); text-decoration: underline; }
  .marca-bloque {
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: var(--rule-hair) solid var(--color-rule);
    padding: 0 var(--space-3xs);
    white-space: nowrap;
    color: var(--color-muted);
  }

  @media (max-width: 52rem) {
    .apertura { grid-template-columns: minmax(0, 1fr); }
    .apertura-lateral {
      border-left: 0; padding-left: 0;
      border-top: var(--rule-hair) solid var(--color-ink);
      padding-top: var(--space-sm);
    }
  }
</style>
