---
import Base from "../layouts/Base.astro";
// Macrostructure: 04 · Stat-Led — la cifra manda y el texto la cualifica.
// La cifra es real (artículos rastreados). Gate 46: nunca un número inventado,
// y nunca un número solo: siempre emparejado con lo que significa.
---

<Base title="El Contraste — radar" seccion="radar">
  <nav class="conmutador" id="conmutador" aria-label="Secciones del radar"></nav>
  <div id="radar"><p class="estado">Midiendo la atención…</p></div>
</Base>

<script>
  import { esc, traer, rotula } from "../lib/ui";

  const seccion = new URLSearchParams(location.search).get("s") ?? "economico";
  const dias = 30;

  async function main() {
    const raiz = document.getElementById("radar")!;

    try {
      const taxonomia: any[] = await traer("/api/topics");
      document.getElementById("conmutador")!.innerHTML = taxonomia
        .map(
          (t) =>
            `<a class="chip${t.section === seccion ? " chip-activo" : ""}" href="/radar?s=${encodeURIComponent(
              t.section,
            )}">${esc(rotula(t.section))}</a>`,
        )
        .join("");
    } catch {
      /* auxiliar */
    }

    try {
      const d: any = await traer(`/api/radar/${encodeURIComponent(seccion)}?days=${dias}`);
      document.getElementById("mast-edicion")!.textContent =
        `Radar de ${rotula(seccion)} · ${d.dias_de_historia} días de historia`;

      const total = d.temas.reduce((a: number, t: any) => a + (t.n_articles ?? 0), 0);
      const maximo = Math.max(1, ...d.temas.map((t: any) => t.n_articles ?? 0));

      // El aviso NO es decorativo: con poca historia el momentum es ruido y la
      // página lo dice en palabras en vez de dibujar una flecha que miente.
      const aviso = d.senal_fiable
        ? ""
        : `<p class="aviso">
             <strong>Señal todavía débil.</strong> El radar lleva
             <span class="dato">${d.dias_de_historia}</span>
             ${d.dias_de_historia === 1 ? "día" : "días"} de historia acumulada y hacen
             falta unos 14 para que el momentum signifique algo. Lo de abajo es un
             recuento honesto, no una tendencia: la columna de momentum queda oculta
             hasta que haya base para calcularla.
           </p>`;

      const filas = d.temas.length
        ? d.temas
            .map(
              (t: any) => `
          <tr>
            <th scope="row">
              <a href="/seccion?s=${encodeURIComponent(seccion)}&tema=${encodeURIComponent(t.topic)}">${esc(
                t.topic,
              )}</a>
            </th>
            <td class="dato">${t.n_articles}</td>
            <td class="dato">${t.n_clusters}</td>
            <td class="celda-barra">
              <span class="barra" style="inline-size: ${Math.round(
                ((t.n_articles ?? 0) / maximo) * 100,
              )}%"></span>
            </td>
            ${
              d.senal_fiable
                ? `<td class="dato ${t.momentum && t.momentum > 1.2 ? "sube" : ""}">${
                    t.momentum ? `×${t.momentum}` : "—"
                  }</td>`
                : ""
            }
          </tr>`,
            )
            .join("")
        : "";

      raiz.innerHTML = `
        <section class="cifra-hero">
          <p class="cifra dato">${total}</p>
          <p class="cifra-frase">
            artículos de ${esc(rotula(seccion))} rastreados en ${dias} días,
            repartidos en <span class="dato">${d.temas.length}</span> temas de la
            taxonomía cerrada.
          </p>
        </section>

        ${aviso}

        <div class="banda">
          <span class="banda-num">01</span>
          <h2>Atención por tema</h2>
          <span class="cuenta">ventana de ${dias} días</span>
        </div>

        ${
          filas
            ? `<div class="tabla-envoltorio">
                 <table class="tabla-radar">
                   <thead>
                     <tr>
                       <th scope="col">Tema</th>
                       <th scope="col">Artículos</th>
                       <th scope="col">Historias</th>
                       <th scope="col"><span class="visualmente-oculto">Proporción</span></th>
                       ${d.senal_fiable ? `<th scope="col">Momentum</th>` : ""}
                     </tr>
                   </thead>
                   <tbody>${filas}</tbody>
                 </table>
               </div>`
            : `<p class="aviso">Todavía no hay nada clasificado en esta sección.</p>`
        }

        <p class="descargo">
          Esto mide <strong>cobertura mediática</strong>, no mercado: cuánto se habla
          de un asunto, no si conviene invertir en él. Un tema se dispara igual por
          una oportunidad que por una crisis, y el radar no distingue entre las dos.
        </p>`;
    } catch (err) {
      raiz.innerHTML = `<p class="estado">No se pudo cargar el radar: ${esc(err)}</p>`;
    }
  }
  main();
</script>

<style is:global>
  .descargo {
    max-width: var(--measure);
    margin: var(--space-xl) 0 0;
    padding-top: var(--space-2xs);
    border-top: var(--rule-hair) solid var(--color-rule);
    font-size: var(--text-sm);
    color: var(--color-neutral);
  }
</style>
