# Copia a .env para construir contra algo que no sea el backend local.
# En CI no se usa este fichero: los valores llegan como secrets del repo.

# Base de la API. En local, el contenedor. En CI, el túnel.
API_BASE_URL=http://localhost:8000

# Service token de Cloudflare Access. Vacíos en local: no hay Access delante
# de localhost, y api.ts solo manda las cabeceras si están los dos.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Días de digest que se hornean.
VENTANA_DIAS=60
